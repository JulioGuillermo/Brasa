#!/usr/bin/env python3
# Generates the sway and Hyprland key bindings from keys.tsv, with my-keys.tsv (the user's own) on top.
# Problems in those files are printed and shown as a notification; their lines are skipped.
import json, os, subprocess, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from brasa_keys_tsv import merged_rows  # noqa: E402

BRASA = os.path.realpath(os.path.expanduser("~/.config/brasa"))
SWAY_MOD = {"SUPER": "$mod", "SHIFT": "Shift", "CTRL": "Ctrl", "ALT": "Mod1"}
SWAY_WM = {"close": "kill", "fullscreen": "fullscreen toggle", "float": "floating toggle",
           "focus": "focus {}", "move": "move {}", "ws": "workspace number {}",
           "movews": "move container to workspace number {}", "reload": "exec ~/.local/bin/brasa-wm reload",
           "focusmon": "focus output {}", "movewsmon": "move workspace to output {}",
           "layout-next": "input type:keyboard xkb_switch_layout next"}
HYPR_WM = {"close": "hl.dsp.window.close()", "kill": "hl.dsp.window.kill()",
           "fullscreen": 'hl.dsp.window.fullscreen({{ action = "toggle" }})',
           "float": 'hl.dsp.window.float({{ action = "toggle" }})',
           "focus": 'hl.dsp.focus({{ direction = "{}" }})', "move": 'hl.dsp.window.move({{ direction = "{}" }})',
           "ws": "hl.dsp.focus({{ workspace = {} }})", "movews": "hl.dsp.window.move({{ workspace = {} }})",
           "focusmon": 'hl.dsp.focus({{ monitor = "{}" }})', "movewsmon": 'hl.dsp.workspace.move({{ monitor = "{}" }})'}
BRASA_WM_VERBS = {"kill", "touchpad", "remote-keys", "layout-cycle"}
WM_VERBS = set(SWAY_WM) | BRASA_WM_VERBS


def lua(s):
    return json.dumps(s, ensure_ascii=False)


def action_problem(action):
    kind, _, rest = action.partition(" ")
    verb = rest.split(" ")[0]
    if kind == "exec" and rest.strip():
        return None
    if kind == "wm" and verb in WM_VERBS:
        return None
    return f'unknown action "{action}" (exec COMMAND, wm VERB or none)'


def report(problems):
    for problem in problems:
        print(f"brasa-gen: {problem}", file=sys.stderr)
    if problems:
        subprocess.run(["notify-send", "-a", "Brasa", "-i", "dialog-warning-symbolic",
                        f"Key bindings: {len(problems)} line(s) skipped", "\n".join(problems[:5])],
                       stderr=subprocess.DEVNULL)


rows, problems = merged_rows()
sway = ["# Generated by brasa-gen from keys.tsv and my-keys.tsv: do not edit by hand."]
hypr = ["-- Generated by brasa-gen from keys.tsv and my-keys.tsv: do not edit by hand."]
for row in rows:
    problem = action_problem(row.action)
    if problem:
        problems.append(f"{row.origin}: {problem}")
        continue
    mods, key, action, desc, opts = row.mods, row.key, row.action, row.description, row.options
    kind, _, rest = action.partition(" ")
    verb, _, arg = rest.partition(" ")
    # sway
    combo = "+".join([SWAY_MOD[m] for m in mods] + [key])
    flags = (" --locked" if "locked" in opts else "") + (" --release" if "release" in opts else "")
    if kind == "exec":
        cmd = "exec " + rest
    elif verb in BRASA_WM_VERBS:
        cmd = f"exec ~/.local/bin/brasa-wm {verb}"
    else:
        cmd = SWAY_WM[verb].format(arg)
    sway.append(f"bindsym{flags} {combo} {cmd}")
    # Hyprland
    hcombo = " + ".join(mods + [key])
    if kind == "exec":
        disp = f"hl.dsp.exec_cmd({lua(rest)})"
    elif verb in HYPR_WM:
        disp = HYPR_WM[verb].format(arg)
    else:  # reload, layout-next, touchpad
        disp = f"hl.dsp.exec_cmd({lua('~/.local/bin/brasa-wm ' + verb)})"
    hflags = [f"description = {lua(desc)}"] + [f"{o.replace('repeat', 'repeating')} = true" for o in opts]
    if "release" in opts:
        hflags.append("non_consuming = true")  # Caps Lock / Num Lock must still reach the keyboard
    hypr.append(f"hl.bind({lua(hcombo)}, {disp}, {{ {', '.join(hflags)} }})")

open(os.path.join(BRASA, "config/sway/binds.conf"), "w").write("\n".join(sway) + "\n")
open(os.path.join(BRASA, "config/hypr/binds.lua"), "w").write("\n".join(hypr) + "\n")
print(f"brasa-gen: {len(sway) - 1} bindings generated")
report(problems)
