#!/usr/bin/env python3
"""The Sessions window (Super+Ctrl+s, and the Sessions button of the panel): dialogs and the keyring in
this session, the remote session, sharing this desktop, where they listen and the SSH server. Everything it does goes
through brasa-follow and brasa-remote."""
import json
import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import brasa_ui  # noqa: E402

BIN = os.path.dirname(os.path.realpath(__file__))
REMOTE = os.path.join(BIN, "brasa-remote")
FOLLOW = os.path.join(BIN, "brasa-follow")
REFRESH_SECONDS = 5
PORT_TYPING_PAUSE_MS = 800
ANY = "any"

SIZES = ["auto", "1280x720", "1600x900", "1920x1080", "2560x1440", "3840x2160"]
SCALES = ["auto", "1", "1.25", "1.5", "1.75", "2"]
SHARE_MODES = [("off", "Off", "not shared"), ("mirror", "Mirror", "share this screen"),
               ("screen", "Screen", "add a virtual monitor"), ("take", "Take", "use it remotely, screens off")]
WM_NAMES = {"sway": "sway", "hyprland": "Hyprland"}
PROTOCOLS = [("vnc", "VNC"), ("rdp", "RDP")]
RDP_LOGINS = [("linux", "Linux password"), ("password", "Own password")]
RDP_SOUNDS = [("remote", "Where you connect from"), ("both", "There and here"), ("off", "Off")]


def run(argv, on_output):
    """Runs a command in the background and calls on_output(stdout) when it ends."""
    process = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)

    def finished(process, result):
        _, stdout, _ = process.communicate_utf8_finish(result)
        on_output(stdout or "")

    process.communicate_utf8_async(None, None, finished)


def run_with_input(argv, text, on_output):
    """Like run, with text written to the command's input."""
    flags = Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE
    process = Gio.Subprocess.new(argv, flags)

    def finished(process, result):
        _, stdout, _ = process.communicate_utf8_finish(result)
        on_output(stdout or "")

    process.communicate_utf8_async(text, None, finished)


def viewers_text(count):
    if count == 0:
        return "Nobody connected"
    return "1 viewer connected" if count == 1 else f"{count} viewers connected"


class Choice(Adw.ComboRow):
    """A combo row over (value, label) pairs; a value that is not among them is added as is."""

    def __init__(self, title, options):
        super().__init__(title=title)
        self.base_options = options
        self.values = []

    def show_value(self, value):
        options = list(self.base_options)
        if value not in [v for v, _ in options]:
            options.append((value, value))
        if [v for v, _ in options] != self.values:
            self.values = [v for v, _ in options]
            self.set_model(Gtk.StringList.new([label for _, label in options]))
        self.set_selected(self.values.index(value))

    def value(self):
        return self.values[self.get_selected()]


class SessionsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Sessions", default_width=560, default_height=720)
        self.updating = False
        self.busy = set()
        self.state = None
        self.rdp_password_set = False

        page = Adw.PreferencesPage()
        page.add(self.build_here())
        page.add(self.build_remote_session())
        page.add(self.build_share())
        page.add(self.build_network())
        page.add(self.build_ssh())
        view = Adw.ToolbarView(content=page)
        view.add_top_bar(brasa_ui.header())
        self.set_content(view)
        brasa_ui.make_brasa(self)

        self.refresh()
        GLib.timeout_add_seconds(REFRESH_SECONDS, self.refresh_periodically)

    def button(self, label, on_click):
        button = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        button.connect("clicked", on_click)
        return button

    def build_here(self):
        group = Adw.PreferencesGroup(
            title="This session",
            description="Password prompts and other dialogs of apps started by the system open in one session")
        self.dialogs_row = Adw.ActionRow(title="Dialogs and passwords")
        self.dialogs_row.add_suffix(self.button("Bring here", lambda _: self.act(
            self.dialogs_row, [[FOLLOW, "here"]])))
        self.keyring_row = Adw.ActionRow(title="Keyring")
        self.keyring_button = self.button("Unlock", self.on_keyring)
        self.keyring_row.add_suffix(self.keyring_button)
        group.add(self.dialogs_row)
        group.add(self.keyring_row)
        return group

    def build_remote_session(self):
        self.session_group = Adw.PreferencesGroup(title="Remote session")
        self.session_on = Adw.SwitchRow(title="On")
        self.session_on.connect("notify::active", lambda row, _: self.switched(
            row, ["session"] if row.get_active() else ["session", "stop"]))
        self.session_boot = Adw.SwitchRow(title="Start at boot", subtitle="Also with nobody logged in")
        self.session_boot.connect("notify::active", lambda row, _: self.switched(
            row, ["session", "boot" if row.get_active() else "noboot"]))
        self.session_wm = Choice("Window manager", [])
        self.session_wm.connect("notify::selected", lambda row, _: self.chosen(row, ["session", "wm"]))
        self.session_size = Choice("Size", [(s, "Follow the viewer" if s == "auto" else s) for s in SIZES])
        self.session_size.connect("notify::selected", lambda row, _: self.chosen(row, ["session", "size"]))
        self.session_scale = Choice("Scale", [(s, "From the height" if s == "auto" else s) for s in SCALES])
        self.session_scale.connect("notify::selected", lambda row, _: self.chosen(row, ["session", "scale"]))
        self.session_protocol = Choice("Protocol", PROTOCOLS)
        self.session_protocol.connect("notify::selected", lambda row, _: self.chosen(row, ["protocol"]))
        self.rdp_login = Choice("RDP sign-in", RDP_LOGINS)
        self.rdp_login.connect("notify::selected", self.on_rdp_login)
        self.rdp_password = Adw.PasswordEntryRow(title="RDP password", show_apply_button=True)
        self.rdp_password.connect("apply", self.on_rdp_password)
        self.rdp_password.connect("entry-activated", self.on_rdp_password)
        self.rdp_sound = Choice("Sound", RDP_SOUNDS)
        self.rdp_sound.connect("notify::selected", lambda row, _: self.chosen(row, ["rdp", "sound"]))
        for row in (self.session_on, self.session_boot, self.session_wm, self.session_protocol, self.rdp_login,
                    self.rdp_password, self.rdp_sound, self.session_size, self.session_scale):
            self.session_group.add(row)
        return self.session_group

    def on_rdp_login(self, row, _):
        """A password of its own needs the password first: the row to type it shows, and saving it switches."""
        if self.updating:
            return
        if row.value() == "password" and not self.rdp_password_set:
            self.rdp_password.set_visible(True)
            self.rdp_password.grab_focus()
            return
        self.act(row, [[REMOTE, "rdp", "login", row.value()]])

    def on_rdp_password(self, entry):
        password = entry.get_text()
        if not password:
            return
        entry.set_show_apply_button(False)
        entry.set_text("")
        entry.set_show_apply_button(True)
        self.busy.add(entry)
        entry.set_sensitive(False)

        def saved(_output):
            self.busy.discard(entry)
            entry.set_sensitive(True)
            self.refresh()

        run_with_input([REMOTE, "rdp", "password"], password + "\n", saved)

    def build_share(self):
        self.share_group = Adw.PreferencesGroup(title="Share this desktop")
        self.share_mode = Choice("Mode", [(mode, f"{name} · {what}") for mode, name, what in SHARE_MODES])
        self.share_mode.connect("notify::selected", self.on_share_mode)
        self.share_group.add(self.share_mode)
        return self.share_group

    def build_network(self):
        """Where the remote session and the shared desktop listen: every network, or some of this
        machine's addresses (one switch each), and their two ports."""
        group = Adw.PreferencesGroup(title="Network",
                                     description="Where the remote session and the shared desktop can be reached. "
                                                 "With ufw on, exactly these are opened while they are on")
        self.listen_row = Adw.ExpanderRow(title="Listen on")
        self.listen_any = Adw.SwitchRow(title="Every network", subtitle="Any address of this machine")
        self.listen_any.connect("notify::active", self.on_listen)
        self.listen_row.add_row(self.listen_any)
        self.address_rows = {}
        self.session_port = self.port_row("Remote session port", "session")
        self.share_port = self.port_row("Shared desktop port", "local")
        for row in (self.listen_row, self.session_port, self.share_port):
            group.add(row)
        return group

    def port_row(self, title, which):
        row = Adw.SpinRow.new_with_range(1024, 65535, 1)
        row.set_title(title)
        row.which = which
        row.pending = 0
        row.connect("notify::value", self.on_port)
        return row

    def on_port(self, row, _):
        """Waits until the typing pauses, then applies it."""
        if self.updating:
            return
        if row.pending:
            GLib.source_remove(row.pending)

        def apply():
            row.pending = 0
            self.act(row, [[REMOTE, "port", row.which, str(int(row.get_value()))]])
            return GLib.SOURCE_REMOVE

        row.pending = GLib.timeout_add(PORT_TYPING_PAUSE_MS, apply)

    def on_listen(self, *_):
        if self.updating:
            return
        chosen = [address for address, row in self.address_rows.items() if row.get_active()]
        if self.listen_any.get_active():
            words = [ANY]
        elif chosen:
            words = chosen
        else:
            self.refresh()
            return
        self.act(self.listen_row, [[REMOTE, "listen", *words]])

    def build_ssh(self):
        self.ssh_group = Adw.PreferencesGroup(title="SSH server")
        self.ssh_on = Adw.SwitchRow(title="On")
        self.ssh_on.connect("notify::active", lambda row, _: self.switched(
            row, ["ssh", "on" if row.get_active() else "off"]))
        self.ssh_boot = Adw.SwitchRow(title="Start at boot")
        self.ssh_boot.connect("notify::active", lambda row, _: self.switched(
            row, ["ssh", "boot" if row.get_active() else "noboot"]))
        self.ssh_group.add(self.ssh_on)
        self.ssh_group.add(self.ssh_boot)
        return self.ssh_group

    def switched(self, row, args):
        if not self.updating:
            self.act(row, [[REMOTE, *args]])

    def chosen(self, row, args):
        if not self.updating:
            self.act(row, [[REMOTE, *args, row.value()]])

    def on_share_mode(self, row, _):
        if self.updating:
            return
        mode = row.value()
        commands = [[REMOTE, "off"]]
        if mode != "off":
            commands.append([REMOTE, mode])
        self.act(row, commands)

    def on_keyring(self, _button):
        action = "lock" if self.keyring_button.get_label() == "Lock" else "unlock"
        self.act(self.keyring_row, [[FOLLOW, "keyring", action]])

    def act(self, row, commands):
        """Runs the commands one after the other, with the row disabled, then shows the new state."""
        self.busy.add(row)
        row.set_sensitive(False)

        def next_command(_output=""):
            if commands:
                run(commands.pop(0), next_command)
                return
            self.busy.discard(row)
            row.set_sensitive(True)
            self.refresh()

        next_command()

    def refresh_periodically(self):
        self.refresh()
        return GLib.SOURCE_CONTINUE

    def refresh(self):
        run([REMOTE, "state"], self.show_remote)
        run([FOLLOW, "where"], self.show_dialogs)
        run([FOLLOW, "keyring", "status"], self.show_keyring)
        return False

    def show_dialogs(self, output):
        where = output.strip()
        self.dialogs_row.set_subtitle("They open here" if where == "here" else f"They open in {where}")

    def show_keyring(self, output):
        status = output.strip()
        known = status in ("locked", "unlocked")
        self.keyring_button.set_visible(known)
        self.keyring_button.set_label("Unlock" if status == "locked" else "Lock")
        self.keyring_row.set_subtitle(status.capitalize() if known else status)

    def show_remote(self, output):
        try:
            state = json.loads(output)
        except json.JSONDecodeError:
            return
        self.updating = True
        self.show_session(state["session"])
        self.show_share(state["share"])
        self.show_ssh(state["ssh"])
        self.show_network(state["network"], state["session"], state["share"]["port"])
        self.updating = False

    def show_session(self, session):
        rdp = session["rdp"]
        if rdp["protocol"] == "rdp" and rdp["ready"]:
            where = rdp["bind"]
        else:
            where = f"{session['address']}:{session['port']}" if session["address"] else f"port {session['port']}"
        self.session_group.set_description(f"A desktop of its own, only for remote use · {where}")
        self.show_rdp(rdp)
        if self.session_on not in self.busy:
            self.session_on.set_active(session["running"])
        self.session_on.set_subtitle(viewers_text(session["viewers"]) if session["running"] else "")
        if self.session_boot not in self.busy:
            self.session_boot.set_active(session["at_boot"])
        self.session_wm.base_options = [(wm, WM_NAMES.get(wm, wm)) for wm in session["wms"]]
        self.session_wm.set_visible(len(session["wms"]) > 1)
        for row, value in ((self.session_wm, session["wm"]), (self.session_size, session["size"]),
                           (self.session_scale, session["scale"])):
            if row not in self.busy:
                row.show_value(value)

    def show_rdp(self, rdp):
        self.rdp_password_set = rdp["password_set"]
        on_rdp = rdp["protocol"] == "rdp"
        if not on_rdp:
            subtitle = "TigerVNC, RealVNC… RDP: Windows Remote Desktop and any RDP client"
        elif not rdp["installed"]:
            subtitle = "Being installed, or not yet: choose it again to install it"
        elif not rdp["ready"]:
            subtitle = "Choose how to sign in: VNC is used meanwhile"
        else:
            subtitle = "Sound, clipboard of text and images, the viewer's keyboard layout"
        self.session_protocol.set_subtitle(subtitle)
        for row, value in ((self.session_protocol, rdp["protocol"]), (self.rdp_login, rdp["login"]),
                           (self.rdp_sound, rdp["sound"])):
            if row not in self.busy:
                row.show_value(value)
        self.rdp_login.set_visible(on_rdp)
        self.rdp_login.set_subtitle("Some clients need it saved before connecting (Windows)"
                                    if rdp["login"] == "linux" else "")
        wants_password = rdp["login"] == "password" or self.rdp_login.value() == "password"
        self.rdp_password.set_visible(on_rdp and wants_password)
        self.rdp_password.set_title("RDP password · set" if rdp["password_set"] else "RDP password")
        self.rdp_sound.set_visible(on_rdp)

    def show_share(self, share):
        self.share_group.set_description(f"So someone can see or use this machine's own screens · port {share['port']}")
        if self.share_mode not in self.busy:
            self.share_mode.show_value(share["mode"])
        self.share_mode.set_subtitle(viewers_text(share["viewers"]) if share["mode"] != "off" else "")

    def show_network(self, network, session, share_port):
        listen = network["listen"].split()
        every = listen == [ANY]
        for entry in network["addresses"]:
            address = entry["address"]
            if address not in self.address_rows:
                label = f"{entry['interface']} · VPN" if entry["vpn"] else entry["interface"]
                row = Adw.SwitchRow(title=address, subtitle=label)
                row.connect("notify::active", self.on_listen)
                self.listen_row.add_row(row)
                self.address_rows[address] = row
            row = self.address_rows[address]
            on = address in listen or (entry["vpn"] and "vpn" in listen)
            if self.listen_row not in self.busy:
                row.set_active(on or every)
            row.set_sensitive(not every)
        if self.listen_row not in self.busy:
            self.listen_any.set_active(every)
        shown = "every network" if every else ", ".join(
            entry["address"] for entry in network["addresses"] if self.address_rows[entry["address"]].get_active())
        self.listen_row.set_subtitle(shown or "nowhere: choose an address")
        rdp = session["rdp"]
        on_rdp = rdp["protocol"] == "rdp"
        self.session_port.which = "rdp" if on_rdp else "session"
        self.session_port.set_title(f"Remote session port ({'RDP' if on_rdp else 'VNC'})")
        self.session_port.set_subtitle("RDP listens on the first address chosen" if on_rdp else "")
        session_port = rdp["port"] if on_rdp else session["port"]
        for row, port in ((self.session_port, session_port), (self.share_port, share_port)):
            if row not in self.busy and not row.pending:
                row.set_value(port)

    def show_ssh(self, ssh):
        self.ssh_group.set_visible(ssh["installed"])
        if not ssh["installed"]:
            return
        self.ssh_group.set_description(f"Port {ssh['port']}")
        if self.ssh_on not in self.busy:
            self.ssh_on.set_active(ssh["running"])
        if self.ssh_boot not in self.busy:
            self.ssh_boot.set_active(ssh["at_boot"])


def main():
    app = Adw.Application(application_id="org.brasa.Sessions")
    app.connect("startup", lambda _: brasa_ui.load_style())
    app.connect("activate", lambda app: (app.get_active_window() or SessionsWindow(app)).present())
    app.run([])


if __name__ == "__main__":
    main()
