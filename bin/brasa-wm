#!/usr/bin/env bash
# Window actions that work the same in sway/SwayFX and Hyprland. Usage: brasa-wm <verb> [arg]
verb=$1 arg=$2
LAYOUTS=${XDG_STATE_HOME:-$HOME/.local/state}/brasa/workspace-layouts   # Hyprland: "workspace layout" lines
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
  d() { hyprctl -q dispatch "$1"; }

  # Hyprland window layouts, per workspace. The scrolling ones put windows on a strip you scroll through:
  # side by side or one above the other, each window half the screen or, in the focus ones, nearly all of
  # it, so only a sliver of its neighbours shows
  LAYOUT_ORDER=(dwindle master scrolling scrolling-down focus focus-down)
  declare -A LAYOUT_NAMES=(
    [dwindle]="dwindle" [master]="master" [scrolling]="scrolling, side by side"
    [scrolling-down]="scrolling, one above the other" [focus]="focus, side by side"
    [focus-down]="focus, one above the other")
  FOCUS_WIDTH=0.9
  saved_layout() {
    local saved
    saved=$(awk -v ws="$1" '$1 == ws { print $2 }' "$LAYOUTS" 2>/dev/null)
    echo "${saved:-dwindle}"
  }
  next_layout() {
    local i
    for i in "${!LAYOUT_ORDER[@]}"; do
      if [ "${LAYOUT_ORDER[$i]}" = "$1" ]; then
        echo "${LAYOUT_ORDER[$(( (i + 1) % ${#LAYOUT_ORDER[@]} ))]}"
        return
      fi
    done
    echo dwindle
  }
  # The Lua rules for a workspace's layout. A focus layout's new windows open nearly full size through a
  # window rule, and BRASA_CENTERED tells hyprland.lua to keep the focused one in the middle; leaving it
  # undoes both
  layout_rules() {
    local ws=$1 layout=$2 algorithm=dwindle direction=right focus=false
    case $layout in
      dwindle|master) algorithm=$layout ;;
      scrolling)      algorithm=scrolling ;;
      scrolling-down) algorithm=scrolling direction=down ;;
      focus)          algorithm=scrolling focus=true ;;
      focus-down)     algorithm=scrolling direction=down focus=true ;;
    esac
    if [ "$algorithm" = scrolling ]; then
      echo "hl.workspace_rule({ workspace = \"$ws\", layout = \"scrolling\", layout_opts = { direction = \"$direction\" } })"
    else
      echo "hl.workspace_rule({ workspace = \"$ws\", layout = \"$algorithm\" })"
    fi
    echo "hl.window_rule({ name = \"brasa-focus-$ws\", match = { workspace = \"$ws\" }, scrolling_width = $FOCUS_WIDTH, enabled = $focus })"
    echo "BRASA_CENTERED[$ws] = $([ $focus = true ] && echo "\"$direction\"" || echo nil)"
  }
  # Hyprland keeps a scrolling workspace's direction until its layout changes, so it goes through dwindle;
  # then every window gets the layout's width (windows opened in a focus layout keep its width otherwise)
  apply_layout() {
    local ws=$1 layout=$2 width
    hyprctl -q eval "hl.workspace_rule({ workspace = \"$ws\", layout = \"dwindle\" })"
    hyprctl -q eval "BRASA_CENTERED = BRASA_CENTERED or {}
$(layout_rules "$ws" "$layout")
if BRASA_FOLLOW_CENTERED then BRASA_FOLLOW_CENTERED() end"
    case $layout in
      focus|focus-down)         width=$FOCUS_WIDTH ;;
      scrolling|scrolling-down) width=$(hyprctl getoption scrolling:column_width -j | jq -r .float) ;;
      *)                        return ;;
    esac
    d "hl.dsp.layout(\"colresize all $width\")"
  }
  # Remembered per workspace in a rules file hyprland.lua loads (dwindle, the default, is not written)
  save_layout() {
    local ws=$1 layout=$2 w l
    mkdir -p "$(dirname "$LAYOUTS")"; touch "$LAYOUTS"
    { grep -v "^$ws " "$LAYOUTS"; [ "$layout" = dwindle ] || echo "$ws $layout"; } | sort -n > "$LAYOUTS.new"
    mv "$LAYOUTS.new" "$LAYOUTS"
    { echo "-- Written by brasa-wm (Super+w): each workspace's window layout"
      echo "BRASA_CENTERED = BRASA_CENTERED or {}"
      while read -r w l; do layout_rules "$w" "$l"; done < "$LAYOUTS"
    } > "${LAYOUTS%/*}/workspace-layouts.lua"
  }

  case $verb in
    close)       d 'hl.dsp.window.close()' ;;
    kill)        d 'hl.dsp.window.kill()' ;;
    fullscreen)  d 'hl.dsp.window.fullscreen({ action = "toggle" })' ;;
    float)       d 'hl.dsp.window.float({ action = "toggle" })' ;;
    focus)       d "hl.dsp.focus({ direction = \"$arg\" })" ;;
    move)        d "hl.dsp.window.move({ direction = \"$arg\" })" ;;
    ws)          d "hl.dsp.focus({ workspace = $arg })" ;;
    movews)      d "hl.dsp.window.move({ workspace = $arg })" ;;
    focusmon)    d "hl.dsp.focus({ monitor = \"$arg\" })" ;;
    movewsmon)   d "hl.dsp.workspace.move({ monitor = \"$arg\" })" ;;
    layout-next) hyprctl -q switchxkblayout all next
                 ~/.local/bin/brasa-osd input-keyboard-symbolic "$(hyprctl devices -j | jq -r '[.keyboards[] | select(.main)][0].active_keymap')" ;;
    reload)      ~/.local/bin/brasa-gen >/dev/null; hyprctl -q reload; sleep 0.5   # the reload finishes asynchronously
                 ~/.local/bin/brasa-fx restore; ~/.local/bin/brasa-monitors apply --settle ;;
    layout-cycle|layout-set) # the focused workspace's layout, see LAYOUT_ORDER
                 ws=$(hyprctl activeworkspace -j | jq -r .id)
                 if [ "$verb" = layout-set ]; then next=$arg
                 else next=$(next_layout "$(saved_layout "$ws")"); fi
                 [[ " ${LAYOUT_ORDER[*]} " == *" $next "* ]] || { echo "layout: ${LAYOUT_ORDER[*]}" >&2; exit 1; }
                 apply_layout "$ws" "$next"
                 save_layout "$ws" "$next"
                 ~/.local/bin/brasa-osd view-grid-symbolic "Workspace $ws: ${LAYOUT_NAMES[$next]}" ;;
    layout-current) saved_layout "$(hyprctl activeworkspace -j | jq -r .id)" ;;   # for the control panel
    dpms)        d "hl.dsp.dpms({ action = \"$arg\" })" ;;
    remote-keys) if [ "$(hyprctl submap | head -1)" = remote ]; then d 'hl.dsp.submap("reset")'; msg=off
                 else d 'hl.dsp.submap("remote")'; msg="on · Ctrl+Super+Esc to leave"; fi
                 ~/.local/bin/brasa-osd input-keyboard-symbolic "Remote keyboard $msg" ;;
    exit)        command -v hyprshutdown >/dev/null && hyprshutdown || d 'hl.dsp.exit()' ;;
    touchpad)    st=${XDG_RUNTIME_DIR:-/tmp}/brasa-touchpad-off
                 tp=$(hyprctl devices -j | jq -r '[.mice[] | select(.name | test("touchpad"; "i"))][0].name')
                 if [ -e "$st" ]; then on=true; rm -f "$st"; else on=false; touch "$st"; fi
                 hyprctl -q eval "hl.device({ name = \"$tp\", enabled = $on })"
                 ~/.local/bin/brasa-osd input-touchpad-symbolic "Touchpad $([ $on = true ] && echo on || echo off)" ;;
  esac
else
  case $verb in
    close)       swaymsg -q kill ;;
    kill)        pid=$(swaymsg -t get_tree | jq '.. | select(.focused? == true) | .pid' | head -1)
                 # Only the focused window's process, never a pkill by name
                 [ -n "$pid" ] && [ "$pid" != null ] && kill -9 "$pid" ;;
    fullscreen)  swaymsg -q fullscreen toggle ;;
    float)       swaymsg -q floating toggle ;;
    focus)       swaymsg -q focus "$arg" ;;
    move)        swaymsg -q move "$arg" ;;
    ws)          swaymsg -q workspace number "$arg" ;;
    movews)      swaymsg -q move container to workspace number "$arg" ;;
    focusmon)    swaymsg -q focus output "$arg" ;;
    movewsmon)   swaymsg -q move workspace to output "$arg" ;;
    layout-next) swaymsg -q input type:keyboard xkb_switch_layout next
                 ~/.local/bin/brasa-osd input-keyboard-symbolic "$(swaymsg -t get_inputs -r | jq -r '[.[] | select(.type == "keyboard")][0].xkb_active_layout_name')" ;;
    reload)      ~/.local/bin/brasa-gen >/dev/null; swaymsg -q reload; ~/.local/bin/brasa-monitors apply --settle ;;
    layout-current) # the focused workspace's layout: splith, splitv, tabbed or stacking
                 swaymsg -t get_tree | jq -r '[.. | objects | select(.type? == "workspace" and any(.. ; .focused? == true))][0].layout' |
                   sed 's/^stacked$/stacking/' ;;   # the tree says "stacked", the command "stacking"
    layout-cycle|layout-set) # sway's own layouts for the focused workspace, like Hyprland's per workspace: side by
                 # side (splith), one above the other (splitv), tabs (tabbed), stacked titles (stacking).
                 # Super+w goes through them; the panel sets one (Hyprland's names map to the nearest)
                 if [ "$verb" = layout-set ]; then
                   case $arg in splitv|scrolling-down|focus-down) l=splitv ;; tabbed|scrolling|focus) l=tabbed ;; stacking) l=stacking ;; *) l=splith ;; esac
                 else
                   case $("$0" layout-current) in splith) l=splitv ;; splitv) l=tabbed ;; tabbed) l=stacking ;; *) l=splith ;; esac
                 fi
                 # "layout" acts on the focused node's container: climb to the workspace, set it, give focus back.
                 # (One command each: criteria in a comma-separated list would apply to every command.)
                 win=$(swaymsg -t get_tree | jq -r '.. | objects | select(.focused? == true and .type? == "con") | .id' | head -1)
                 for _ in 1 2 3 4 5 6; do
                   [ "$(swaymsg -t get_tree | jq -r '.. | objects | select(.focused? == true) | .type' | head -1)" = workspace ] && break
                   swaymsg -q "focus parent"
                 done
                 swaymsg -q layout "$l"
                 [ -n "$win" ] && swaymsg -q "[con_id=$win] focus"
                 case $l in splith) n="side by side" ;; splitv) n="one above the other" ;; tabbed) n="tabs" ;; *) n="stacked" ;; esac
                 ~/.local/bin/brasa-osd view-grid-symbolic "Workspace $(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused) | .name'): $n" ;;
    dpms)        swaymsg -q output '*' power "$arg" ;;
    remote-keys) if [ "$(swaymsg -t get_binding_state -r | jq -r .name)" = remote ]; then swaymsg -q mode default; msg=off
                 else swaymsg -q mode remote; msg="on · Ctrl+Super+Esc to leave"; fi
                 ~/.local/bin/brasa-osd input-keyboard-symbolic "Remote keyboard $msg" ;;
    remote-watch) # sway has no focus hook in its config: follow focus changes, remote mode in viewers
                 swaymsg -m -t subscribe '["window"]' | jq --unbuffered -r 'select(.change == "focus") |
                     (.container.app_id // .container.window_properties.class // "")' | while read -r app; do
                   cur=$(swaymsg -t get_binding_state -r | jq -r .name)
                   if [[ $app =~ ^(Vncviewer|vncviewer|wlvncc|xfreerdp|wlfreerdp|sdl-freerdp|sdl3-freerdp|remote-viewer|virt-viewer)$ ]]; then
                     [ "$cur" = remote ] || { swaymsg -q mode remote
                       ~/.local/bin/brasa-osd input-keyboard-symbolic "Remote keyboard on · Ctrl+Super+Esc to leave"; }
                   elif [ "$cur" = remote ]; then swaymsg -q mode default; fi
                 done ;;
    exit)        swaymsg -q exit ;;
    touchpad)    swaymsg -q input type:touchpad events toggle enabled disabled
                 st=$(swaymsg -t get_inputs -r | jq -r '[.[] | select(.type == "touchpad")][0].libinput.send_events')
                 ~/.local/bin/brasa-osd input-touchpad-symbolic "Touchpad $([ "$st" = disabled ] && echo off || echo on)" ;;
  esac
fi
