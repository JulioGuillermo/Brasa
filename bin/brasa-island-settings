#!/usr/bin/env python3
"""The Island window (Super+Shift+m, and the Island button of the panel): what the islands show (music,
notifications, app launcher), which monitor, edge and side each sits on, and how they behave. Every
change is saved to island.conf and the islands move at once."""
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GObject, Gtk

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import brasa_ui  # noqa: E402
import brasa_island_config as island_config  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
ISLANDS = os.path.expanduser("~/.local/bin/brasa-islands")
EDGES = [("top", "Top"), ("bottom", "Bottom")]
ALIGNS = [("left", "Left"), ("center", "Center"), ("right", "Right")]
VIEWS = [("grid", "Grid of icons"), ("list", "List")]
SIZES = [("small", "Small"), ("medium", "Medium"), ("large", "Large")]
SIDES = [("left", "Bottom left corner"), ("right", "Bottom right corner")]
QUICK_SIZES = [("small", "Small · 6 tiles a page"), ("medium", "Medium · 12 tiles a page"), ("large", "Large · every tile at once")]
FOCUSED_MONITOR = ("", "Any (the focused one)")


def monitor_options():
    options = [FOCUSED_MONITOR]
    monitors = sorted(Gdk.Display.get_default().get_monitors(), key=lambda monitor: monitor.get_geometry().x)
    for monitor in monitors:
        geometry = monitor.get_geometry()
        name = monitor.get_description() or monitor.get_model() or ""
        shape = "vertical" if geometry.height > geometry.width else "horizontal"
        options.append((monitor.get_connector(), f"{monitor.get_connector()} · {shape} · {name}".rstrip(" ·")))
    return options


def rgba(color):
    parsed = Gdk.RGBA()
    parsed.parse(color)
    return parsed


def hex_color(color: Gdk.RGBA) -> str:
    return "#{:02x}{:02x}{:02x}".format(*(round(part * 255) for part in (color.red, color.green, color.blue)))


class Choice(Adw.ComboRow):
    """A combo row over (value, label) pairs; a value not among them (an unplugged monitor) is added as is."""

    def __init__(self, title, options, value):
        super().__init__(title=title)
        if value not in [v for v, _ in options]:
            options = [*options, (value, f"{value} · not connected")]
        self.values = [v for v, _ in options]
        self.set_model(Gtk.StringList.new([label for _, label in options]))
        self.set_selected(self.values.index(value))

    def value(self):
        return self.values[self.get_selected()]


class PlaceRows:
    """Monitor, edge and side rows for one island."""

    def __init__(self, place: island_config.Place, on_change):
        self.monitor = Choice("Monitor", monitor_options(), place.monitor)
        self.edge = Choice("Edge", EDGES, place.edge)
        self.align = Choice("Side", ALIGNS, place.align)
        self.rows = [self.monitor, self.edge, self.align]
        for row in self.rows:
            row.connect("notify::selected", on_change)

    def value(self) -> island_config.Place:
        return island_config.Place(edge=self.edge.value(), align=self.align.value(), monitor=self.monitor.value())


def sensitive_while(switch: Adw.SwitchRow, rows):
    for row in rows:
        switch.bind_property("active", row, "sensitive", GObject.BindingFlags.SYNC_CREATE)


class IslandWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Island", default_width=540, default_height=720)
        self.config = island_config.load()
        page = Adw.PreferencesPage()
        page.add(self.build_main())
        page.add(self.build_launcher())
        page.add(self.build_quick())
        page.add(self.build_both())
        view = Adw.ToolbarView(content=page)
        view.add_top_bar(brasa_ui.header())
        self.set_content(view)
        brasa_ui.make_brasa(self)

    def build_main(self):
        group = Adw.PreferencesGroup(title="Music and notifications",
                                     description="Super+m opens it, Super+n with the notification centre · each change shows it at once where it is")
        self.media = Adw.SwitchRow(title="Music", subtitle="What is playing, with its controls",
                                   active=self.config.media)
        self.centre = Adw.SwitchRow(title="Notification centre with Super+m",
                                    subtitle="Off: Super+m shows only the music; Super+n and the bell still list them",
                                    active=self.config.notification_centre)
        self.peek = Adw.SpinRow.new_with_range(0, 10, 0.5)
        self.peek.set_title("Peek on a new track or play/pause")
        self.peek.set_subtitle("Seconds · 0: never")
        self.peek.set_digits(1)
        self.peek.set_value(self.config.peek_seconds)
        self.peek.connect("notify::value", self.changed)
        sensitive_while(self.media, [self.peek])
        self.main_place = PlaceRows(self.config.place, self.changed)
        self.hover = Adw.SwitchRow(title="Open with the pointer",
                                   subtitle="Resting it on the island's edge, in the middle",
                                   active=self.config.hover)
        for row in (self.media, self.centre, self.hover):
            row.connect("notify::active", self.changed)
        for row in (self.media, self.peek, self.centre, *self.main_place.rows, self.hover):
            group.add(row)
        return group

    def build_launcher(self):
        group = Adw.PreferencesGroup(title="App launcher",
                                     description="Super+d opens it · in the same place as the music, they share one island")
        self.launcher = Adw.SwitchRow(title="On", active=self.config.launcher)
        self.launcher.connect("notify::active", self.changed)
        self.launcher_place = PlaceRows(self.config.launcher_place, self.changed)
        self.view = Choice("Apps as", VIEWS, self.config.launcher_view)
        self.size = Choice("Size", SIZES, self.config.launcher_size)
        for row in (self.view, self.size):
            row.connect("notify::selected", self.changed)
        self.launcher_hover = Adw.SwitchRow(title="Open with the pointer",
                                            subtitle="Where it shares an island with the music, only if the music's is off",
                                            active=self.config.launcher_hover)
        self.launcher_hover.connect("notify::active", self.changed)
        settings = [*self.launcher_place.rows, self.view, self.size, self.launcher_hover]
        sensitive_while(self.launcher, settings)
        for row in (self.launcher, *settings):
            group.add(row)
        return group

    def build_quick(self):
        group = Adw.PreferencesGroup(title="Quick settings", description="Super+a or the bar's gear opens it")
        self.quick_monitor = Choice("Monitor", monitor_options(), self.config.quick_monitor)
        self.quick_side = Choice("Corner", SIDES, self.config.quick_side)
        self.quick_size = Choice("Size", QUICK_SIZES, self.config.quick_size)
        for row in (self.quick_monitor, self.quick_side, self.quick_size):
            row.connect("notify::selected", self.changed)
            group.add(row)
        self.quick_hover = Adw.SwitchRow(title="Open with the pointer",
                                         subtitle="Resting it in the bottom corner",
                                         active=self.config.quick_hover)
        self.quick_hover.connect("notify::active", self.changed)
        group.add(self.quick_hover)
        return group

    def build_both(self):
        group = Adw.PreferencesGroup(title="Both")
        self.color = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False), rgba=rgba(self.config.color),
                                           valign=Gtk.Align.CENTER)
        self.color.connect("notify::rgba", self.changed)
        color_row = Adw.ActionRow(title="Colour", subtitle="Far from the edge; black at the edge")
        color_row.add_suffix(self.color)
        group.add(color_row)
        return group

    def changed(self, *_):
        self.config.place = self.main_place.value()
        self.config.media = self.media.get_active()
        self.config.notification_centre = self.centre.get_active()
        self.config.peek_seconds = self.peek.get_value()
        self.config.launcher = self.launcher.get_active()
        self.config.launcher_place = self.launcher_place.value()
        self.config.launcher_view = self.view.value()
        self.config.launcher_size = self.size.value()
        self.config.hover = self.hover.get_active()
        self.config.launcher_hover = self.launcher_hover.get_active()
        self.config.quick_monitor = self.quick_monitor.value()
        self.config.quick_hover = self.quick_hover.get_active()
        self.config.quick_side = self.quick_side.value()
        self.config.quick_size = self.quick_size.value()
        self.config.color = hex_color(self.color.get_rgba())
        island_config.save(self.config)
        subprocess.Popen([ISLANDS, "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    app = Adw.Application(application_id="org.brasa.Island")
    app.connect("startup", lambda _: brasa_ui.load_style())
    app.connect("activate", lambda app: (app.get_active_window() or IslandWindow(app)).present())
    app.run([])


if __name__ == "__main__":
    main()
