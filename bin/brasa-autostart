#!/usr/bin/env bash
# What starts with the session, the same in sway/SwayFX and Hyprland.
# Brasa commands added by a later "git pull": link any that is missing (install.sh does the rest)
for f in ~/.config/brasa/bin/brasa-*; do [ -e ~/.local/bin/"${f##*/}" ] || ln -s "$f" ~/.local/bin/ 2>/dev/null; done
# The remote session (brasa-remote session) must not overwrite the local session's environment
[ -n "${BRASA_REMOTE_SESSION:-}" ] || \
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null
~/.local/bin/brasa-fx reset
~/.local/bin/brasa-monitors apply --settle   # saved layout + refresh rate of every monitor
# Start a program unless this session already runs it. Only this session's processes count: the remote
# session (brasa-remote session) and the local one each have their own bar, notifications, lock...
here() { ~/.local/bin/brasa-here "$@" >/dev/null; }
run() {
  here "$1" && return
  setsid -f "$@" >/dev/null 2>&1
}

# Hyprland draws no wallpaper: swaybg does it (sway does it itself with "output * bg")
[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && run swaybg -m fill -c '#00040f' -i ~/.local/share/backgrounds/brasa.png

run swayosd-server
here -f 'brasa-monitors watch' || \
  setsid -f ~/.local/bin/brasa-monitors watch >/dev/null 2>&1   # re-apply on hotplug
# The island is the notification server: before anything sends one, which would start swaync through D-Bus
pkill -u "$(id -u)" -x swaync
here -f '^brasa-island' || setsid -f ~/.local/bin/brasa-island >/dev/null 2>&1   # music and notifications (Super+m)
~/.local/bin/brasa-bar   # one bar per monitor, folded on narrow ones
# sway: your keyboard layouts (brasa-keyboard; Hyprland loads them in hyprland.lua)
[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -s ~/.config/brasa/keyboard.conf ] && ~/.local/bin/brasa-keyboard apply
# sway: remote keyboard in VNC/RDP viewers (Hyprland does it in hyprland.lua)
[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && { here -f "brasa-wm remote-watch" ||
  setsid -f ~/.local/bin/brasa-wm remote-watch >/dev/null 2>&1; }
run nm-applet --indicator
run blueman-applet
for a in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
         /usr/libexec/polkit-gnome-authentication-agent-1 \
         /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
         /usr/lib/hyprpolkitagent/hyprpolkitagent; do
  [ -x "$a" ] && { here -f "$a" || setsid -f "$a" >/dev/null 2>&1; break; }
done
command -v cliphist >/dev/null && { here -f "wl-paste --watch cliphist" ||
  setsid -f wl-paste --watch cliphist store >/dev/null 2>&1; }

# Lock after 15 min (like GNOME), screen off after 20, and always lock before suspending
run swayidle -w \
  timeout 900  '~/.local/bin/brasa-lock' \
  timeout 1200 '~/.local/bin/brasa-wm dpms off' resume '~/.local/bin/brasa-wm dpms on' \
  before-sleep '~/.local/bin/brasa-lock'
