#!/usr/bin/env bash
# Quick settings: a panel on the left or right edge with tiles (Wi-Fi, Bluetooth, mute, layout, power...),
# pages of six that the mouse wheel goes through, volume and brightness.
# Usage: brasa-quick            open or close it (Super+a, the bar's gear)
#        brasa-quick start      start it hidden (brasa-autostart does, so it opens at once)
# Side: quick_side in ~/.config/brasa/island.conf, or the Island window (Super+Shift+m).
# Your own tiles: ~/.config/brasa/panel.conf.
if [ -e ~/.config/brasa/rust-islands ]; then
  [ "${1:-toggle}" = toggle ] && exec ~/.local/bin/brasa-islands quick
  exec ~/.local/bin/brasa-islands "$@"
fi
lib=$(dirname "$(realpath "$0")")/../lib
PYTHONPATH="$lib" LD_PRELOAD=libgtk4-layer-shell.so.0 exec -a brasa-quick \
  python3 -W ignore::DeprecationWarning -m brasa_quick "$@"
