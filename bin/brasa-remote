#!/usr/bin/env bash
# Remote desktop over VNC (wayvnc) for Brasa, the same on Hyprland and sway/SwayFX.
#
# Everything is off by default. Two independent servers, which can run at the same time:
#   port 5900  session   your remote desktop
#   port 5901  screen / mirror / take   the local desktop (whoever is logged in on the machine)
# All of it works over SSH too: the local modes find the running Hyprland or sway by themselves.
#
# Modes
#   session [stop|boot|noboot]   an independent remote-only session (sway without a physical screen,
#                                or Hyprland on a virtual one), persistent: closing the viewer leaves
#                                it running with its windows.
#                                boot/noboot: start it automatically when the machine boots (or not)
#   session wm sway|hyprland     its window manager (sway by default, or Hyprland if it is the only
#                                one). hyprland asks for sudo once, to install a virtual screen (the
#                                kernel module vkms, if missing) and the system service that runs it
#   session size auto|WxH        auto (default): starts at 1920x1080 and takes the viewer's size;
#                                WxH: always that size, e.g. 2560x1440
#   session scale auto|N         auto (default): picked from the height; N: fixed, e.g. 1.25
#   session defaults             back to size auto and scale auto
#   session settings             show them
#                                (size/scale apply at once to a running session, and are kept)
#   screen [WxH]                 a virtual second monitor in the current session (default 1920x1080)
#   mirror                       share the physical screen as it is (the focused monitor)
#   take [WxH]                   take over the current session: physical screens off, local keyboard
#                                and mouse ignored, everything on a virtual monitor. When the last viewer
#                                disconnects (or nobody connects within REMOTE_TAKE_WAIT seconds) it all
#                                comes back and the session is locked
#
#   ssh [on|off|boot|noboot]     the SSH server: on / off now, start at boot or not (asks for sudo).
#                                Turning it off keeps open connections; only new ones are refused
#
#   protocol [vnc|rdp]           how the remote session is reached, one at a time: VNC (wayvnc) or RDP
#                                (hypr-rdp: Windows Remote Desktop and any RDP client, with sound and the
#                                clipboard of images too). RDP is built the first time (a few minutes,
#                                in a terminal that opens for it)
#   rdp login linux|password     RDP sign-in: your Linux password (clients that send it over TLS without
#                                NLA; Windows may ask to save it first) or a password of its own (every client)
#   rdp password                 set that password (read from the input) and sign in with it
#   rdp sound remote|both|off    where the remote session sounds while someone is connected over RDP:
#                                on their device, on both, or nowhere
#
#   listen [vpn|any|IP...]       where the VNC servers listen: vpn (default) the VPN address; any every
#                                network; or this machine's addresses, e.g. listen 10.0.0.5 192.168.1.20.
#                                Without an argument it shows them. A running session follows at once
#   port session|local|rdp N     the session's VNC port (5900), the local desktop's (5901), or the
#                                session's RDP port (3389). RDP listens on the first address of "listen"
#
# Commands
#   on                           the default mode (REMOTE_DEFAULT, "session" unless changed)
#   off                          stop screen / mirror / take (the session keeps running)
#   status                       what is running, where to connect, who is connected
#   state                        the same as JSON (for the Sessions window)
#   setup                        (re)create keys and config; done automatically the first time
#   help                         this help
#
# Settings, optional, in ~/.config/brasa/remote.conf:
#   REMOTE_DEFAULT=session   REMOTE_WM=sway|hyprland (default: sway, or Hyprland if it is the only one)   REMOTE_SIZE=1920x1080   REMOTE_SCALE=auto   REMOTE_RESIZE=yes
#   REMOTE_LISTEN=vpn|any|<ip> <ip>...   (REMOTE_ADDRESS=<ip>, the older form, is still read)
#   Session size: it starts at REMOTE_SIZE and then takes the viewer's size (TigerVNC asks for its window
#   size: full screen = one remote pixel per screen pixel) unless REMOTE_RESIZE=no. VNC tells the size
#   but not the scale, so REMOTE_SCALE=auto picks it from the height (up to 1200 px: 1, 1500: 1.25,
#   1900: 1.333, 2200: 1.5, more: 2); or set a fixed one, e.g. REMOTE_SCALE=1.5
#   REMOTE_PORT=5900 (session)   REMOTE_LOCAL_PORT=5901 (screen / mirror / take)   REMOTE_TAKE_WAIT=180
#   REMOTE_PROTOCOL=vnc|rdp   REMOTE_RDP_PORT=3389   REMOTE_RDP_LOGIN=linux|password   REMOTE_RDP_SOUND=remote|both|off
#
# Security: by default it listens only on a VPN interface (ZeroTier, WireGuard, Tailscale, OpenVPN...),
# never on every network unless "listen any". You log in with your Linux user and password (PAM),
# encrypted with RSA-AES (TigerVNC, RealVNC) or TLS.
# Firewall: with ufw on, exactly the addresses and ports the VNC servers and SSH listen on are opened
# while they are on, and closed when they stop (brasa-firewall, installed once with sudo).
set -u
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/wayvnc
STATE=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/brasa-remote
UNIT=brasa-wayvnc                 # screen / mirror / take
SESSION_UNIT=brasa-remote-session # session on sway (user service)
HYPR_UNIT=brasa-remote-hyprland@$USER.service # session on Hyprland (system service)
VIRTUAL=BRASA-REMOTE
SESSION_OUTPUT=HEADLESS-REMOTE    # the Hyprland session's desktop (wayvnc only resizes HEADLESS-*)
B=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
installed_wm() {  # the remote session's window manager when none was chosen: sway, or Hyprland if it is the only one
  if ! command -v sway >/dev/null && command -v Hyprland >/dev/null; then echo hyprland; else echo sway; fi
}
REMOTE_DEFAULT=session REMOTE_WM=$(installed_wm) REMOTE_SIZE=1920x1080 REMOTE_SCALE=auto REMOTE_RESIZE=yes REMOTE_PORT=5900 REMOTE_LOCAL_PORT=5901 REMOTE_TAKE_WAIT=180
REMOTE_PROTOCOL=vnc REMOTE_RDP_PORT=3389 REMOTE_RDP_LOGIN=linux REMOTE_RDP_SOUND=remote
REMOTE_ADDRESS=
[ -f ~/.config/brasa/remote.conf ] && . ~/.config/brasa/remote.conf
REMOTE_LISTEN=${REMOTE_LISTEN:-${REMOTE_ADDRESS:-vpn}}
mkdir -p "$STATE"
say() {  # TITLE [BODY]: a notification for 5 s (a click closes it); each one replaces the previous
  notify-send -a "Remote desktop" -i network-workgroup-symbolic -t 5000 \
    -h string:x-canonical-private-synchronous:brasa-remote "$1" "${2:-}" 2>/dev/null
  echo "$1${2:+ · $2}"
}
also_on() {  # what else is running, for the notifications: "Also on: ..." or "Nothing else is on"
  local l=()
  [ "$1" != session ] && session_running && l+=("Remote session · $(where)")
  [ "$1" = session ] && running && l+=("$(mode_name "$(cat "$STATE/mode" 2>/dev/null)") · port $REMOTE_LOCAL_PORT")
  if [ ${#l[@]} -gt 0 ]; then echo "Also on: ${l[*]}"; else echo "Nothing else is on"; fi
}
working() {  # an immediate "in progress" notice (swaync has no spinner on its buttons); the result's say()
  # replaces it, as both use the same synchronous hint
  notify-send -a "Remote desktop" -i network-workgroup-symbolic -t 30000 \
    -h string:x-canonical-private-synchronous:brasa-remote "$1" "Working…" 2>/dev/null
}
mode_name() {
  case $1 in session) echo "Remote session" ;; rdp) echo "Remote session over RDP" ;; screen) echo "Virtual screen" ;;
             mirror) echo "Screen mirror" ;; take) echo "Take over" ;; *) echo "Remote desktop" ;; esac
}
usage() { sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

vpn_address() {  # first IPv4 of a VPN interface
  ip -o -4 addr show 2>/dev/null | awk '$2 ~ /^(zt|wg|tailscale|tun|tap|ppp|nordlynx)/ { split($4, a, "/"); print a[1]; exit }'
}

own_addresses() {  # this machine's IPv4 addresses a viewer can reach, as "address interface"
  ip -o -4 addr show 2>/dev/null |
    awk '$2 !~ /^(lo|docker|br-|virbr|veth|vnet)/ { split($4, a, "/"); print a[1], $2 }'
}
listen_setting() {  # remote.conf as it is now: a running session re-reads it each time wayvnc starts
  local listen; listen=$( (REMOTE_ADDRESS=; REMOTE_LISTEN=; . "$USER_CONF" 2>/dev/null; echo "${REMOTE_LISTEN:-${REMOTE_ADDRESS:-vpn}}") )
  echo "${listen:-vpn}"
}
setting() {  # KEY DEFAULT: remote.conf's value now (a running session re-reads it each time its server starts)
  ( . "$USER_CONF" 2>/dev/null; eval "echo \${$1:-$2}" )
}
port_setting() {  # session|local|rdp: the port remote.conf sets now
  case $1 in
    local) setting REMOTE_LOCAL_PORT 5901 ;;
    rdp) setting REMOTE_RDP_PORT 3389 ;;
    *) setting REMOTE_PORT 5900 ;;
  esac
}
listen_addresses() {  # the addresses to listen on, one per line
  local word
  for word in $(listen_setting); do
    case $word in
      vpn) vpn_address ;;
      any) echo 0.0.0.0 ;;
      *) echo "$word" ;;
    esac
  done
}
listen_args() {  # PORT: wayvnc's address arguments, ADDRESS:PORT for each
  local addr; for addr in $(listen_addresses); do echo "$addr:$1"; done
}
setup() {
  local addr; addr=$(listen_addresses | head -1)
  if [ -z "$addr" ]; then
    echo "No VPN interface found: choose where to listen, e.g. brasa-remote listen any (or a Sessions window choice)." >&2
    return 1
  fi
  mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR"
  # TLS certificate (self-signed) and RSA key for RSA-AES, only created once
  [ -f "$CONF_DIR/tls_key.pem" ] || openssl req -x509 -newkey rsa:3072 -nodes -days 3650 -subj "/CN=$(hostname)" \
      -keyout "$CONF_DIR/tls_key.pem" -out "$CONF_DIR/tls_cert.pem" 2>/dev/null
  # RSA-AES needs the traditional PKCS#1 format ("BEGIN RSA PRIVATE KEY"), not PKCS#8
  [ -f "$CONF_DIR/rsa_key.pem" ] || openssl genrsa -traditional -out "$CONF_DIR/rsa_key.pem" 3072 2>/dev/null
  chmod 600 "$CONF_DIR"/*.pem
  cat > "$CONF_DIR/config" <<EOF
# Written by brasa-remote: where to listen comes from REMOTE_LISTEN (brasa-remote listen); log in with
# the Linux user and password (PAM).
use_relative_paths=true
address=$addr
port=$REMOTE_PORT
enable_auth=true
enable_pam=true
username=$USER
certificate_file=tls_cert.pem
private_key_file=tls_key.pem
rsa_private_key_file=rsa_key.pem
EOF
  chmod 600 "$CONF_DIR/config"
  echo "wayvnc set up: $addr:$REMOTE_PORT, user $USER (your Linux password)"
}
address() { listen_addresses | paste -sd' '; }
where_on() { listen_args "$1" | paste -sd' ' | sed 's/ /, /g'; }  # PORT -> "a:port, b:port"
where() {  # the session
  if serves_rdp; then rdp_bind; else where_on "$(port_setting session)"; fi
}
where_local() { where_on "$REMOTE_LOCAL_PORT"; }

local_desktop() {  # over SSH, or from inside the remote session: point at the local Hyprland / sway
  [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${BRASA_REMOTE_SESSION:-}" ] && return 0
  export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  unset HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK WAYLAND_DISPLAY BRASA_REMOTE_SESSION
  local p env
  # Hyprland lists its instances with their Wayland socket; the remote session's one is not local
  if command -v hyprctl >/dev/null; then
    env=$(hyprctl instances -j 2>/dev/null | jq -r --arg remote "$(cat "$STATE/session-hypr" 2>/dev/null)" \
      '[.[] | select(.instance != $remote)] | sort_by(.time) | last // empty | "\(.instance) \(.wl_socket)"')
    if [ -n "$env" ]; then
      export HYPRLAND_INSTANCE_SIGNATURE=${env% *} WAYLAND_DISPLAY=${env#* }; return 0
    fi
  fi
  # sway: take the variables from a process of the local session (its bar), not the remote one
  for p in $(pgrep -u "$(id -u)" -x waybar) $(pgrep -u "$(id -u)" -x swaync); do
    env=$(tr '\0' '\n' < /proc/$p/environ 2>/dev/null) || continue
    grep -q '^BRASA_REMOTE_SESSION=' <<< "$env" && continue
    grep -q '^SWAYSOCK=' <<< "$env" || continue
    export SWAYSOCK=$(sed -n 's/^SWAYSOCK=//p' <<< "$env") WAYLAND_DISPLAY=$(sed -n 's/^WAYLAND_DISPLAY=//p' <<< "$env")
    [ -S "$SWAYSOCK" ] && return 0
  done
  echo "No local desktop running (nobody logged in?). 'brasa-remote session' works without one." >&2
  exit 1
}

hypr() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; }

scale_for() {  # WxH -> the scale to use: REMOTE_SCALE, or with "auto" one picked from the height
  [ "$REMOTE_SCALE" != auto ] && { echo "$REMOTE_SCALE"; return; }
  local h=${1#*x}
  if   [ "$h" -le 1200 ]; then echo 1
  elif [ "$h" -le 1500 ]; then echo 1.25
  elif [ "$h" -le 1900 ]; then echo 1.333333
  elif [ "$h" -le 2200 ]; then echo 1.5
  else echo 2; fi
}
resize_flag() { [ "$REMOTE_RESIZE" = no ] && echo -R; }

layout() {  # your first keyboard layout, for wayvnc's key mapping (characters such as ñ need it)
  # brasa-keyboard's list first: a remote session has no keyboard yet when wayvnc starts
  local l; l=$(awk 'NF { print $1 (NF > 1 ? "-" $2 : ""); exit }' ~/.config/brasa/keyboard.conf 2>/dev/null)
  [ -n "$l" ] && { echo "$l"; return; }
  if hypr; then hyprctl getoption input:kb_layout -j 2>/dev/null | jq -r '.str // empty' | cut -d, -f1
  else sed -n 's/^\s*xkb_layout\s\+//p' ~/.config/sway/brasa.conf 2>/dev/null | head -1 | cut -d, -f1; fi
}

create_virtual() {  # size -> prints the virtual monitor's name
  local name
  if hypr; then hyprctl -q output create headless "$VIRTUAL"; name=$VIRTUAL
  else swaymsg -q create_output; name=$(swaymsg -t get_outputs -r | jq -r '[.[] | select(.name | startswith("HEADLESS"))] | last | .name'); fi
  sleep 0.5
  wlr-randr --output "$name" --custom-mode "${1}@60Hz" >/dev/null 2>&1
  wlr-randr --output "$name" --scale "$(scale_for "$1")" >/dev/null 2>&1   # else the compositor guesses one
  echo "$name"
}
remove_virtual() {
  local name; name=$(cat "$STATE/virtual" 2>/dev/null) || return 0
  if hypr; then hyprctl -q output remove "$name"; else swaymsg -q output "$name" unplug; fi
  rm -f "$STATE/virtual"
}

running() { systemctl --user -q is-active "$UNIT" 2>/dev/null; }
session_running() {
  if [ "$REMOTE_WM" = hyprland ]; then systemctl -q is-active "$HYPR_UNIT" 2>/dev/null
  else systemctl --user -q is-active "$SESSION_UNIT" 2>/dev/null; fi
}
session_at_boot() {
  if [ "$REMOTE_WM" = hyprland ]; then systemctl -q is-enabled "$HYPR_UNIT" 2>/dev/null
  else systemctl --user -q is-enabled "$SESSION_UNIT" 2>/dev/null; fi
}
busy() {  # one local mode at a time (they share port $REMOTE_LOCAL_PORT); the session is separate
  if running; then echo "Already on: $(cat "$STATE/mode" 2>/dev/null) on $(where_local). 'brasa-remote off' first."; return 0; fi
  return 1
}

start_vnc() {  # mode output [extra wayvnc args...] -- runs wayvnc as a transient user service, so it
  # survives closing the terminal or SSH session that started it; log: journalctl --user -u brasa-wayvnc
  local mode=$1 out=$2; shift 2
  working "$(mode_name "$mode")"
  [ -f "$CONF_DIR/config" ] || setup || exit 1
  local kb; kb=$(layout)
  echo "$mode" > "$STATE/mode"; echo "$out" > "$STATE/output"
  systemctl --user reset-failed "$UNIT" 2>/dev/null
  systemd-run --user --quiet --unit="$UNIT" --collect \
    --setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    ${HYPRLAND_INSTANCE_SIGNATURE:+--setenv=HYPRLAND_INSTANCE_SIGNATURE="$HYPRLAND_INSTANCE_SIGNATURE"} \
    ${SWAYSOCK:+--setenv=SWAYSOCK="$SWAYSOCK"} \
    ${STOP_POST:+-p ExecStopPost="$STOP_POST"} \
    wayvnc -C "$CONF_DIR/config" -o "$out" ${kb:+-k "$kb"} -g -f 60 -r -L info -S "$STATE/wayvnc.sock" "$@" \
      $(listen_args "$REMOTE_LOCAL_PORT")
  sleep 1.5
  if ! running; then
    say "$(mode_name "$mode") failed to start" "journalctl --user -u $UNIT"
    [ "$mode" = take ] || { remove_virtual; rm -f "$STATE/mode" "$STATE/output"; }
    exit 1
  fi
  firewall_sync
  say "$(mode_name "$mode") ON" "Port $REMOTE_LOCAL_PORT · $(where_local)
$(also_on local)"
}

# ---------------------------------------------------------------- where the VNC servers listen
is_own_address() { own_addresses | awk '{ print $1 }' | grep -qxF "$1"; }
listen_cmd() {  # [vpn|any|IP...]
  if [ $# -eq 0 ]; then
    echo "listening on: $(listen_setting) ($(address))"
    echo "this machine's addresses:"; own_addresses | sed 's/^/  /'
    return
  fi
  local word
  for word in "$@"; do
    case $word in
      vpn) [ -n "$(vpn_address)" ] || { echo "No VPN interface is up" >&2; exit 1; } ;;
      any) [ $# -eq 1 ] || { echo "'any' already covers every address: use it alone" >&2; exit 1; } ;;
      *) is_own_address "$word" || { echo "$word is not an address of this machine (brasa-remote listen shows them)" >&2; exit 1; } ;;
    esac
  done
  conf_set REMOTE_LISTEN "\"$*\""
  listen_changed "Listening on $(address)"
}
port_cmd() {  # session|local|rdp N
  local which=${1:-} port=${2:-} other
  case $which in session|local|rdp) ;; *) echo "brasa-remote port session|local|rdp N" >&2; exit 1 ;; esac
  [[ $port =~ ^[0-9]+$ ]] && [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] ||
    { echo "A port between 1024 and 65535" >&2; exit 1; }
  for other in session local rdp; do
    [ "$other" = "$which" ] || [ "$port" != "$(port_setting "$other")" ] ||
      { echo "Port $port is already the $other port: each one needs its own" >&2; exit 1; }
  done
  case $which in
    session) conf_set REMOTE_PORT "$port"; REMOTE_PORT=$port ;;
    local) conf_set REMOTE_LOCAL_PORT "$port"; REMOTE_LOCAL_PORT=$port ;;
    rdp) conf_set REMOTE_RDP_PORT "$port"; REMOTE_RDP_PORT=$port ;;
  esac
  listen_changed "$(mode_name "$which") on port $port"
}
listen_changed() {  # MESSAGE: the session's wayvnc starts again on the new addresses and ports (its loop
  # re-reads remote.conf); a shared desktop keeps them until it is started again
  [ -f "$CONF_DIR/config" ] && setup >/dev/null
  restart_session_server
  local note=""
  running && note="The shared desktop takes it the next time it starts"
  firewall_sync
  say "$1" "$note"
}

# ---------------------------------------------------------------- firewall: ufw follows what is on
FIREWALL=/usr/local/sbin/brasa-firewall
SUDOERS=/etc/sudoers.d/brasa-firewall
firewall_installed() { cmp -s "$B/remote/brasa-firewall" "$FIREWALL" && sudo -n -l "$FIREWALL" >/dev/null 2>&1; }
firewall_install() {  # the helper, sudo for it without a password, and a hook on the SSH server
  command -v ufw >/dev/null || return 0
  firewall_installed && return 0
  [ -t 0 ] || [ "$(id -u)" = 0 ] || return 0
  echo "Letting ufw follow the remote desktop and SSH: installing $FIREWALL (sudo)"
  local sudo rule u; sudo=$(sudo_prefix)
  $sudo install -Dm755 "$B/remote/brasa-firewall" "$FIREWALL" || return 1
  rule=$(mktemp); echo "$USER ALL=(root) NOPASSWD: $FIREWALL \"\"" > "$rule"
  visudo -cqf "$rule" && $sudo install -Dm440 "$rule" "$SUDOERS"; rm -f "$rule"
  u=$(ssh_unit 2>/dev/null) && printf '[Service]\nExecStartPost=-%s\nExecStopPost=-%s\n' "$FIREWALL" "$FIREWALL" |
    $sudo install -Dm644 /dev/stdin "/etc/systemd/system/$u.service.d/brasa-firewall.conf" && $sudo systemctl daemon-reload
  $sudo "$FIREWALL"
}
firewall_sync() {  # [now]: by default a moment later, in the background: wayvnc and sshd take a moment
  firewall_install  # to listen, or to go
  [ -x "$FIREWALL" ] || return 0
  if [ "${1:-}" = now ]; then sudo -n "$FIREWALL" >/dev/null 2>&1; return 0; fi
  ( sleep 2; sudo -n "$FIREWALL" >/dev/null 2>&1 ) &
}

# ---------------------------------------------------------------- take: hand the session over, safely
take_devices() {  # local keyboards, mice and touch devices (taken before wayvnc adds its virtual ones)
  if hypr; then hyprctl devices -j | jq -r '(.keyboards[], .mice[], (.touch // [])[], (.tablets // [])[]) | .name' | sort -u
  else swaymsg -t get_inputs -r | jq -r '.[] | select(.type | test("keyboard|pointer|touch|tablet")) | .identifier' | sort -u; fi
}
set_devices() {  # on|off  (the list saved in $STATE/take-devices)
  local d on=$1
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    if hypr; then hyprctl -q eval "hl.device({ name = \"$d\", enabled = $([ "$on" = on ] && echo true || echo false) })"
    else swaymsg -q input "$d" events "$([ "$on" = on ] && echo enabled || echo disabled)"; fi
  done < "$STATE/take-devices"
}
take_restore() {  # runs when the take service stops, whatever the reason
  [ -f "$STATE/take-outputs" ] || return 0
  local o
  while IFS= read -r o; do [ -n "$o" ] && wlr-randr --output "$o" --on >/dev/null 2>&1; done < "$STATE/take-outputs"
  [ -f "$STATE/take-devices" ] && set_devices on
  sleep 0.5
  ~/.local/bin/brasa-monitors apply --settle >/dev/null 2>&1
  remove_virtual
  systemctl --user stop brasa-take-watch.timer 2>/dev/null
  rm -f "$STATE/take-outputs" "$STATE/take-devices" "$STATE/mode" "$STATE/output"
  firewall_sync now
  say "Take over OFF" "Port $REMOTE_LOCAL_PORT closed; screens, keyboard and mouse are back, session locked
$(also_on local)"
  ~/.local/bin/brasa-lock
}
take() {
  busy && exit 0
  [ -f "$CONF_DIR/config" ] || setup || exit 1
  ~/.local/bin/brasa-monitors list | jq -r '.[].name' > "$STATE/take-outputs"
  take_devices > "$STATE/take-devices"
  local v; v=$(create_virtual "${1:-$REMOTE_SIZE}"); echo "$v" > "$STATE/virtual"
  # Physical screens off: their workspaces move to the virtual monitor
  local o; while IFS= read -r o; do wlr-randr --output "$o" --off >/dev/null 2>&1; done < "$STATE/take-outputs"
  set_devices off
  # wayvnc exits when the last viewer leaves (-e); stopping the service restores everything
  STOP_POST="$HOME/.local/bin/brasa-remote _take-restore" start_vnc take "$v" -e
  # Nobody connected in time? Give everything back
  systemd-run --user --quiet --unit=brasa-take-watch --collect --on-active="${REMOTE_TAKE_WAIT}s" \
    --setenv=XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" "$HOME/.local/bin/brasa-remote" _take-watch
}

# ---------------------------------------------------------------- ssh: the system's SSH server
ssh_unit() {  # sshd.service (Arch, Fedora, openSUSE) or ssh.service (Debian, Ubuntu)
  local u; for u in sshd ssh; do
    systemctl list-unit-files "$u.service" --no-legend 2>/dev/null | grep -q . && { echo "$u"; return; }
  done
  echo "No SSH server installed (openssh)." >&2; exit 1
}
ssh_info() {  # one line: running or not, at boot or not, port
  local u=$1 port
  port=$(sshd -T 2>/dev/null | awk '$1 == "port" { print $2; exit }'); port=${port:-22}
  echo "$(systemctl -q is-active "$u" && echo on || echo off), $(systemctl -q is-enabled "$u" 2>/dev/null &&
    echo starts at boot || echo does not start at boot) · port $port"
}
sudo_prefix() {  # sudo in a terminal; without one (the control panel) systemctl asks through polkit's dialog
  { [ "$(id -u)" = 0 ] || [ ! -t 0 ]; } || echo sudo
}
ssh_cmd() {
  local u; u=$(ssh_unit)
  local sudo; sudo=$(sudo_prefix)
  case ${1:-status} in
    on)     working SSH; $sudo systemctl start "$u" && firewall_sync && say "SSH ON" "$(ssh_info "$u")" ;;
    off)    working SSH; $sudo systemctl stop "$u" && firewall_sync && say "SSH OFF" "Open connections stay; new ones are refused
$(ssh_info "$u")" ;;
    boot)   working SSH; $sudo systemctl enable "$u" >/dev/null 2>&1 && say "SSH starts at boot" "$(ssh_info "$u")" ;;
    noboot) working SSH; $sudo systemctl disable "$u" >/dev/null 2>&1 && say "SSH does not start at boot" "$(ssh_info "$u")" ;;
    status) echo "ssh: $(ssh_info "$u")" ;;
    *) usage; exit 1 ;;
  esac
}

# ---------------------------------------------------------------- rdp: hypr-rdp for the remote session
RDP_SOURCE=$B/remote/hypr-rdp   # COMMIT: the upstream commit built; sway.patch: Brasa's changes to it
RDP_URL=https://github.com/MuNeNICK/hypr-rdp
RDP_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/brasa/hypr-rdp
RDP_BIN=~/.local/bin/hypr-rdp
RDP_PASSWORD=~/.config/brasa/rdp-password
RDP_PAM=/etc/pam.d/hypr-rdp

rdp_version() { cat "$RDP_SOURCE/COMMIT" "$RDP_SOURCE/sway.patch" | sha256sum | cut -c1-16; }
rdp_up_to_date() { [ -x "$RDP_BIN" ] && [ "$(cat "$RDP_DIR.version" 2>/dev/null)" = "$(rdp_version)" ]; }
rdp_password_set() { [ -s "$RDP_PASSWORD" ]; }
rdp_ready() {  # installed, and its sign-in can work
  [ -x "$RDP_BIN" ] || return 1
  if [ "$(setting REMOTE_RDP_LOGIN linux)" = password ]; then rdp_password_set; else [ -f "$RDP_PAM" ]; fi
}
serves_rdp() { [ "$(setting REMOTE_PROTOCOL vnc)" = rdp ] && rdp_ready; }
rdp_bind() {  # ADDRESS:PORT: hypr-rdp listens on one address, the first one "listen" gives
  echo "$(listen_addresses | head -1):$(port_setting rdp)"
}
rdp_audio_mode() {
  case $(setting REMOTE_RDP_SOUND remote) in both) echo mirror ;; off) echo off ;; *) echo redirect ;; esac
}
rdp_viewers() {  # PORT: open RDP connections
  ss -tnH state established "( sport = :$1 )" 2>/dev/null | wc -l
}

rdp_has_build_tools() {
  command -v clang >/dev/null && command -v cmake >/dev/null && command -v git >/dev/null &&
    pkg-config --exists libpipewire-0.3 libva fuse3 xkbcommon 2>/dev/null
}
rdp_build_tools() {  # what building hypr-rdp needs besides cargo
  local sudo; sudo=$(sudo_prefix)
  echo "Installing what building the RDP server needs (sudo)"
  if command -v pacman >/dev/null; then
    $sudo pacman -S --needed --noconfirm git clang cmake pkgconf pipewire libva pam fuse3 libxkbcommon
  elif command -v apt-get >/dev/null; then
    $sudo apt-get install -y git clang libclang-dev cmake pkg-config libpipewire-0.3-dev libva-dev libpam0g-dev \
      libfuse3-dev libxkbcommon-dev
  elif command -v dnf >/dev/null; then
    $sudo dnf install -y git clang clang-devel cmake pkgconf pipewire-devel libva-devel pam-devel fuse3-devel libxkbcommon-devel
  elif command -v zypper >/dev/null; then
    $sudo zypper install -y git clang cmake pkg-config pipewire-devel libva-devel pam-devel fuse3-devel libxkbcommon-devel
  else
    echo "Install clang, cmake, git and the PipeWire, libva, PAM, FUSE 3 and xkbcommon headers" >&2; return 1
  fi
}
rdp_build() {  # hypr-rdp at the pinned commit with Brasa's patch; nothing to do when it is up to date
  rdp_up_to_date && return 0
  command -v cargo >/dev/null || { echo "Building the RDP server needs cargo (Rust)" >&2; return 1; }
  rdp_has_build_tools || { [ -t 0 ] && rdp_build_tools; } || return 1
  local commit; commit=$(cat "$RDP_SOURCE/COMMIT")
  [ -d "$RDP_DIR/.git" ] || git clone -q "$RDP_URL" "$RDP_DIR" || return 1
  git -C "$RDP_DIR" cat-file -e "$commit^{commit}" 2>/dev/null || git -C "$RDP_DIR" fetch -q origin || return 1
  git -C "$RDP_DIR" checkout -q -f "$commit" && git -C "$RDP_DIR" clean -q -f -d &&
    git -C "$RDP_DIR" apply "$RDP_SOURCE/sway.patch" || return 1
  echo "Building the RDP server (hypr-rdp): a few minutes the first time"
  (cd "$RDP_DIR" && cargo build --release --locked --quiet) || return 1
  install -Dm755 "$RDP_DIR/target/release/hypr-rdp" "$RDP_BIN" && rdp_version > "$RDP_DIR.version"
}
rdp_pam_install() {  # the PAM service of the Linux sign-in (sudo, once)
  [ -f "$RDP_PAM" ] && return 0
  [ -t 0 ] || [ "$(id -u)" = 0 ] || return 1
  local file=$RDP_DIR/pkg/pam/hypr-rdp.arch
  command -v apt-get >/dev/null && file=$RDP_DIR/pkg/pam/hypr-rdp.debian
  echo "Letting the RDP server check your Linux password: installing $RDP_PAM (sudo)"
  $(sudo_prefix) install -Dm644 "$file" "$RDP_PAM"
}
rdp_install() {  # in a terminal: build tools, the build, the PAM service, the firewall helper
  if ! rdp_build; then say "The RDP server did not build" "cd $RDP_DIR && cargo build --release shows why"; return 1; fi
  rdp_pam_install || echo "No PAM service: sign in with an RDP password instead (brasa-remote rdp password)" >&2
  firewall_install
}
in_terminal() {  # ARGS...: brasa-remote ARGS in a terminal, where sudo and the build can be followed
  local cmd; cmd=$(printf '%q ' "$HOME/.local/bin/brasa-remote" "$@")
  ~/.local/bin/brasa-app terminal bash -c "$cmd; echo; read -rp 'Enter closes this window'" &
  say "Installing the RDP server" "In the terminal that opened"
}
protocol_name() { [ "$1" = rdp ] && echo RDP || echo VNC; }
protocol_cmd() {  # [vnc|rdp]
  case ${1:-} in
    "") echo "protocol: $(setting REMOTE_PROTOCOL vnc)"; return ;;
    vnc|rdp) ;;
    *) echo "brasa-remote protocol vnc|rdp" >&2; exit 1 ;;
  esac
  if [ "$1" = rdp ] && ! rdp_up_to_date; then
    [ -t 0 ] || { in_terminal protocol rdp; return; }
    rdp_install || exit 1
  fi
  conf_set REMOTE_PROTOCOL "$1"
  restart_session_server
  firewall_sync
  if [ "$1" = rdp ] && ! rdp_ready; then
    say "Remote session over RDP: not ready" "Set an RDP password, or install the Linux sign-in: brasa-remote rdp login linux"
  else
    say "Remote session over $(protocol_name "$1")" "$(where)"
  fi
}
rdp_cmd() {
  case ${1:-} in
    login)
      case ${2:-} in
        password) rdp_password_set || { echo "Set the RDP password first: brasa-remote rdp password" >&2; exit 1; } ;;
        linux) [ -f "$RDP_PAM" ] || { [ -t 0 ] && rdp_pam_install; } ||
                 { in_terminal rdp login linux; return; } ;;
        *) echo "brasa-remote rdp login linux|password" >&2; exit 1 ;;
      esac
      conf_set REMOTE_RDP_LOGIN "$2" ;;
    password)
      local password
      if [ -t 0 ]; then read -rsp "RDP password: " password; echo; else IFS= read -r password; fi
      [ -n "$password" ] || { echo "The password cannot be empty" >&2; exit 1; }
      mkdir -p "$(dirname "$RDP_PASSWORD")"
      (umask 077; printf '%s\n' "$password" > "$RDP_PASSWORD")
      conf_set REMOTE_RDP_LOGIN password ;;
    sound)
      case ${2:-} in remote|both|off) conf_set REMOTE_RDP_SOUND "$2" ;;
        *) echo "brasa-remote rdp sound remote|both|off" >&2; exit 1 ;; esac ;;
    build) rdp_build; return ;;
    install) rdp_install; return ;;
    *) usage; exit 1 ;;
  esac
  [ "$(setting REMOTE_PROTOCOL vnc)" = rdp ] && restart_session_server
  echo "RDP: sign-in $(setting REMOTE_RDP_LOGIN linux), sound $(setting REMOTE_RDP_SOUND remote)"
}

# ---------------------------------------------------------------- session: independent, persistent
session_unit() {
  mkdir -p ~/.config/systemd/user
  cat > ~/.config/systemd/user/$SESSION_UNIT.service <<EOF
# Written by brasa-remote: an independent remote-only session (sway without a physical screen + wayvnc)
[Unit]
Description=Brasa remote session (headless sway + wayvnc)

[Service]
Environment=BRASA_REMOTE_SESSION=1 WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1
Environment=XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland
# Never inherit the local session's compositor from the user manager: the remote session's scripts would
# talk to the local Hyprland/sway (wrong data, and keys acting on the local screen)
UnsetEnvironment=HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY SWAYSOCK DISPLAY I3SOCK
ExecStart=/usr/bin/dbus-run-session -- sway -c %h/.config/sway/remote.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
}

# ---- the session on Hyprland: a system service, a virtual screen in seat1, the files in remote/
HYPR_FILES="72-brasa-remote-seat.rules:/etc/udev/rules.d
brasa-remote-hyprland@.service:/etc/systemd/system
50-brasa-remote.rules:/usr/share/polkit-1/rules.d"
hypr_installed() {
  local f
  while IFS=: read -r f dir; do cmp -s "$B/remote/$f" "$dir/$f" || return 1; done <<< "$HYPR_FILES"
}
vkms_package() {  # the package with the vkms module for the running kernel, by distro
  if command -v apt-get >/dev/null; then echo "linux-modules-extra-$(uname -r)"
  elif command -v dnf >/dev/null; then echo "kernel-modules-extra-$(uname -r)"
  elif command -v zypper >/dev/null; then echo kernel-default-extra
  fi
}
vkms_install() {  # the virtual screen of the Hyprland session: the kernel module vkms
  modinfo vkms >/dev/null 2>&1 && return 0
  if [ ! -d "/lib/modules/$(uname -r)" ]; then
    echo "The kernel was updated and its modules are gone until you reboot: reboot, then try again" >&2; exit 1
  fi
  local pkg sudo; pkg=$(vkms_package); sudo=$(sudo_prefix)
  [ -n "$pkg" ] || { echo "The kernel has no vkms module (virtual screen) and Brasa does not know its package here" >&2; exit 1; }
  echo "Installing the virtual screen module vkms: $pkg (sudo)"
  if command -v apt-get >/dev/null; then $sudo apt-get install -y "$pkg"
  elif command -v dnf >/dev/null; then $sudo dnf install -y "$pkg"
  else $sudo zypper install -y "$pkg"; fi
  modinfo vkms >/dev/null 2>&1 || { echo "vkms is still missing after installing $pkg" >&2; exit 1; }
}
hypr_install() {
  modinfo vkms >/dev/null 2>&1 && hypr_installed && return 0
  [ -t 0 ] || [ "$(id -u)" = 0 ] || { echo "Run it once in a terminal: it needs sudo to install the virtual screen" >&2; exit 1; }
  vkms_install
  hypr_installed && return 0
  echo "Installing the virtual screen and the system service of the Hyprland session (sudo)"
  local sudo f dir; sudo=$(sudo_prefix)
  while IFS=: read -r f dir; do $sudo install -Dm644 "$B/remote/$f" "$dir/$f" || exit 1; done <<< "$HYPR_FILES"
  $sudo udevadm control --reload
  $sudo systemctl daemon-reload
}
hypr_session_size() {  # WxH: the monitor rule of the session's output, live and in the file remote.lua loads
  local rule="hl.monitor({ output = \"$SESSION_OUTPUT\", mode = \"$1@60\", position = \"0x0\", scale = $(scale_for "$1") })"
  echo "$rule" > "$STATE/session-monitor.lua"
  hyprctl -q eval "$rule"
}
hypr_session_current_size() {
  local monitors
  monitors=$(hyprctl monitors -j 2>/dev/null) || return 1
  jq -r --arg o "$SESSION_OUTPUT" '.[] | select(.name == $o) | "\(.width)x\(.height)"' <<< "$monitors"
}
hypr_follow_viewer() {  # wayvnc resizes the output to the viewer's window, and Hyprland sends no event for it
  local last=$REMOTE_SIZE size
  while sleep 1; do
    size=$(hypr_session_current_size) || break
    [ -n "$size" ] && [ "$size" != "$last" ] || continue
    last=$size
    hypr_session_size "$size"
  done
}
session_wm() {
  case ${1:-} in
    sway|hyprland) ;;
    "") echo "window manager: $REMOTE_WM"; return ;;
    *) echo "brasa-remote session wm sway|hyprland" >&2; exit 1 ;;
  esac
  [ "$1" = hyprland ] && { command -v Hyprland >/dev/null || { echo "Hyprland is not installed" >&2; exit 1; }; hypr_install; }
  [ "$1" = "$REMOTE_WM" ] && { echo "The remote session already uses $1"; return; }
  local was_running=no was_at_boot=no
  session_running && was_running=yes
  session_at_boot && was_at_boot=yes
  [ $was_running = yes ] && session stop
  [ $was_at_boot = yes ] && session noboot
  conf_set REMOTE_WM "$1"; REMOTE_WM=$1
  echo "The remote session uses $1"
  [ $was_at_boot = yes ] && session boot
  [ $was_running = yes ] && session start
  true
}
# ---- remote.conf settings, changed by "session size|scale|defaults"
USER_CONF=~/.config/brasa/remote.conf
conf_set() {  # KEY VALUE: replace or add the line
  mkdir -p "$(dirname "$USER_CONF")"; touch "$USER_CONF"
  if grep -q "^$1=" "$USER_CONF"; then sed -i "s|^$1=.*|$1=$2|" "$USER_CONF"; else echo "$1=$2" >> "$USER_CONF"; fi
}
conf_unset() { [ -f "$USER_CONF" ] && sed -i "/^$1=/d" "$USER_CONF"; return 0; }
session_sway() {  # the remote session's sway IPC socket, if it is running
  # (the service's main process is dbus-run-session, sway is its child; sway's own environment cannot be
  # read, it makes itself non-dumpable)
  local main p
  main=$(systemctl --user show -p MainPID --value "$SESSION_UNIT" 2>/dev/null)
  [ -n "$main" ] && [ "$main" != 0 ] || return 1
  p=$(pgrep -P "$main" -x sway) || return 1
  echo "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sway-ipc.$(id -u).$p.sock"
}
session_live() {  # apply the current size/scale settings to a running session
  if [ "$REMOTE_WM" = hyprland ]; then session_live_hypr; return; fi
  local sock out size
  sock=$(session_sway) || return 0
  out=$(swaymsg -s "$sock" -t get_outputs -r | jq -r '.[0].name')
  [ "$REMOTE_RESIZE" = no ] && swaymsg -q -s "$sock" -- output "$out" mode --custom "${REMOTE_SIZE}@60Hz"
  size=$(swaymsg -s "$sock" -t get_outputs -r | jq -r '.[0] | "\(.current_mode.width)x\(.current_mode.height)"')
  swaymsg -q -s "$sock" output "$out" scale "$(scale_for "$size")"
  echo "Applied to the running session: $size at scale $(scale_for "$size")"
}
session_live_hypr() {
  session_running || return 0
  local size
  export HYPRLAND_INSTANCE_SIGNATURE; HYPRLAND_INSTANCE_SIGNATURE=$(cat "$STATE/session-hypr")
  size=$REMOTE_SIZE
  [ "$REMOTE_RESIZE" = no ] || size=$(hypr_session_current_size)
  hypr_session_size "$size"
  echo "Applied to the running session: $size at scale $(scale_for "$size")"
}
session_settings() {
  if [ "$REMOTE_RESIZE" = no ]; then echo "size:  $REMOTE_SIZE (fixed)"
  else echo "size:  auto (starts at $REMOTE_SIZE, then takes the viewer's size)"; fi
  if [ "$REMOTE_SCALE" = auto ]; then echo "scale: auto (from the height)"; else echo "scale: $REMOTE_SCALE (fixed)"; fi
}
compositor_alive() {
  if hypr; then hyprctl version >/dev/null 2>&1; else swaymsg -t get_version >/dev/null 2>&1; fi
}
serve_session() {  # OUTPUT: VNC or RDP, as remote.conf says each time, for as long as the session lives
  while compositor_alive; do
    firewall_sync
    if serves_rdp; then serve_rdp "$1"; else serve_vnc "$1"; fi
    sleep 0.5
  done
}
serve_vnc() {  # OUTPUT
  # wayvnc's virtual keyboard keeps the layout it starts with, so choosing another layout in the remote
  # session (brasa-keyboard) saves it in $STATE/session-layout and stops wayvnc: the loop starts it
  # again with that layout (the viewer reconnects)
  local kb; kb=$(cat "$STATE/session-layout" 2>/dev/null); kb=${kb:-$(layout)}
  wayvnc -C "$CONF_DIR/config" -o "$1" ${kb:+-k "$kb"} -g -f 60 -r $(resize_flag) -L info -S "$STATE/session.sock" \
    $(listen_args "$(port_setting session)")
}
serve_rdp() {  # OUTPUT: hypr-rdp, which resizes the output to the viewer's window as wayvnc does. The
  # keyboard layout is the viewer's own
  local args=(--bind "$(rdp_bind)" --resize-output "$1" --audio-mode "$(rdp_audio_mode)")
  [ "$REMOTE_RESIZE" = no ] && args+=(--resolution "$REMOTE_SIZE")
  [ "$REMOTE_SCALE" = auto ] || args+=(--scale "$REMOTE_SCALE")
  if [ "$(setting REMOTE_RDP_LOGIN linux)" = password ]; then args+=(-u "$USER" --password-file "$RDP_PASSWORD")
  else args+=(--auth-mode pam); fi
  "$RDP_BIN" "${args[@]}" &
  echo $! > "$STATE/session-rdp.pid"
  wait $!
  rm -f "$STATE/session-rdp.pid"
}
restart_session_server() {  # the session's server starts again, reading remote.conf (viewers reconnect)
  session_running || return 0
  wayvncctl -S "$STATE/session.sock" wayvnc-exit >/dev/null 2>&1
  local pid; pid=$(cat "$STATE/session-rdp.pid" 2>/dev/null) && kill "$pid" 2>/dev/null
  return 0
}
session_log() {
  if [ "$REMOTE_WM" = hyprland ]; then echo "journalctl -u $HYPR_UNIT"; else echo "journalctl --user -u $SESSION_UNIT"; fi
}
session_restart_note() {
  session_running && echo "(follows the viewer or not from the next start: brasa-remote session stop, then session)"
}

viewers() {  # SOCKET: how many viewers are connected to that wayvnc
  wayvncctl -j -S "$1" client-list 2>/dev/null | jq length 2>/dev/null || echo 0
}
installed_wms() {
  local wms=()
  command -v sway >/dev/null && wms+=(sway)
  command -v Hyprland >/dev/null && wms+=(hyprland)
  printf '%s\n' "${wms[@]}" | jq -R . | jq -s -c .
}
ssh_state() {
  local u
  u=$(ssh_unit 2>/dev/null) || { echo '{"installed": false}'; return; }
  local port; port=$(sshd -T 2>/dev/null | awk '$1 == "port" { print $2; exit }')
  jq -n -c --argjson running "$(systemctl -q is-active "$u" && echo true || echo false)" \
    --argjson at_boot "$(systemctl -q is-enabled "$u" 2>/dev/null && echo true || echo false)" \
    --argjson port "${port:-22}" '{installed: true, $running, $at_boot, $port}'
}
network_state() {  # where it listens, and the addresses it could
  local vpn; vpn=$(vpn_address)
  own_addresses | jq -R -s -c --arg listen "$(listen_setting)" --arg vpn "$vpn" '
    {listen: $listen,
     addresses: [split("\n")[] | select(length > 0) | split(" ") | {address: .[0], interface: .[1], vpn: (.[0] == $vpn)}]}'
}
state_json() {  # everything the session window shows, as JSON
  local size=auto mode=off share_viewers=0 session_viewers=0
  [ "$REMOTE_RESIZE" = no ] && size=$REMOTE_SIZE
  if running; then mode=$(cat "$STATE/mode" 2>/dev/null); share_viewers=$(viewers "$STATE/wayvnc.sock"); fi
  if session_running; then
    if serves_rdp; then session_viewers=$(rdp_viewers "$(port_setting rdp)")
    else session_viewers=$(viewers "$STATE/session.sock"); fi
  fi
  jq -n \
    --argjson running "$(session_running && echo true || echo false)" \
    --argjson at_boot "$(session_at_boot && echo true || echo false)" \
    --arg wm "$REMOTE_WM" --argjson wms "$(installed_wms)" --arg size "$size" --arg scale "$REMOTE_SCALE" \
    --arg address "$(address 2>/dev/null)" --argjson port "$REMOTE_PORT" --argjson viewers "$session_viewers" \
    --arg mode "${mode:-off}" --argjson local_port "$REMOTE_LOCAL_PORT" --argjson share_viewers "$share_viewers" \
    --argjson ssh "$(ssh_state)" --argjson network "$(network_state)" --argjson rdp "$(rdp_state)" \
    '{session: {$running, $at_boot, $wm, $wms, $size, $scale, $address, $port, $viewers, $rdp},
      share: {$mode, port: $local_port, viewers: $share_viewers}, $ssh, $network}'
}
rdp_state() {
  jq -n -c --arg protocol "$(setting REMOTE_PROTOCOL vnc)" --argjson port "$(port_setting rdp)" \
    --arg bind "$(rdp_bind)" --arg login "$(setting REMOTE_RDP_LOGIN linux)" --arg sound "$(setting REMOTE_RDP_SOUND remote)" \
    --argjson installed "$([ -x "$RDP_BIN" ] && echo true || echo false)" \
    --argjson ready "$(rdp_ready && echo true || echo false)" \
    --argjson password_set "$(rdp_password_set && echo true || echo false)" \
    --argjson linux_login "$([ -f "$RDP_PAM" ] && echo true || echo false)" \
    '{$protocol, $port, $bind, $login, $sound, $installed, $ready, $password_set, $linux_login}'
}

session() {
  case ${1:-start} in
    size)
      case ${2:-} in
        auto) conf_unset REMOTE_SIZE; conf_unset REMOTE_RESIZE; REMOTE_SIZE=1920x1080 REMOTE_RESIZE=yes ;;
        [0-9]*x[0-9]*) [[ $2 =~ ^[0-9]+x[0-9]+$ ]] || { echo "Size as WxH, e.g. 2560x1440" >&2; exit 1; }
                       conf_set REMOTE_SIZE "$2"; conf_set REMOTE_RESIZE no; REMOTE_SIZE=$2 REMOTE_RESIZE=no ;;
        *) echo "brasa-remote session size auto|WxH" >&2; exit 1 ;;
      esac
      session_settings; session_live; session_restart_note ;;
    scale)
      case ${2:-} in
        auto) conf_unset REMOTE_SCALE; REMOTE_SCALE=auto ;;
        *) [[ ${2:-} =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk "BEGIN { exit !(${2} >= 0.5 && ${2} <= 4) }" ||
             { echo "brasa-remote session scale auto|N  (N between 0.5 and 4, e.g. 1.25)" >&2; exit 1; }
           conf_set REMOTE_SCALE "$2"; REMOTE_SCALE=$2 ;;
      esac
      session_settings; session_live ;;
    defaults)
      conf_unset REMOTE_SIZE; conf_unset REMOTE_SCALE; conf_unset REMOTE_RESIZE
      REMOTE_SIZE=1920x1080 REMOTE_SCALE=auto REMOTE_RESIZE=yes
      session_settings; session_live; session_restart_note ;;
    settings) echo "wm:    $REMOTE_WM"; session_settings ;;
    wm) session_wm "${2:-}" ;;
    active) session_running ;;
    at-boot) session_at_boot ;;
    start)
      if session_running; then echo "The remote session is already running on $(where)"; return; fi
      [ -f "$CONF_DIR/config" ] || setup || exit 1
      firewall_install
      if [ "$REMOTE_WM" = hyprland ]; then
        command -v Hyprland >/dev/null || { echo "The remote session needs Hyprland installed." >&2; exit 1; }
        hypr_install
      else
        command -v sway >/dev/null || { echo "The remote session needs sway or SwayFX installed." >&2; exit 1; }
        session_unit
      fi
      working "Remote session"
      rm -f "$STATE/session-layout" "$STATE/session-layout-index"   # a new session starts with your first layout
      if [ "$REMOTE_WM" = hyprland ]; then systemctl start "$HYPR_UNIT"; else systemctl --user start "$SESSION_UNIT"; fi
      sleep 3
      if session_running; then say "Remote session ON" "$REMOTE_WM · $(protocol_name "$(serves_rdp && echo rdp)") · $(where)
$(also_on session)"
      else say "Remote session failed to start" "$(session_log)"; exit 1; fi ;;
    stop)
      if ! session_running; then echo "The remote session is not running"; return; fi
      working "Remote session"
      if [ "$REMOTE_WM" = hyprland ]; then systemctl stop "$HYPR_UNIT"; else systemctl --user stop "$SESSION_UNIT"; fi &&
        firewall_sync && say "Remote session OFF" "Port $REMOTE_PORT closed, its windows too
$(also_on session)" ;;
    boot)
      if [ "$REMOTE_WM" = hyprland ]; then
        hypr_install
        $(sudo_prefix) systemctl enable "$HYPR_UNIT" >/dev/null 2>&1 || exit 1
      else
        session_unit; systemctl --user enable "$SESSION_UNIT" >/dev/null 2>&1
        # A user service starting at boot without anyone logged in needs "linger"
        loginctl enable-linger "$USER" 2>/dev/null || sudo loginctl enable-linger "$USER"
      fi
      say "Remote session starts at boot" "Also with nobody logged in · port $REMOTE_PORT" ;;
    noboot)
      if [ "$REMOTE_WM" = hyprland ]; then $(sudo_prefix) systemctl disable "$HYPR_UNIT" >/dev/null 2>&1 || exit 1
      else systemctl --user disable "$SESSION_UNIT" >/dev/null 2>&1; fi
      say "Remote session does not start at boot" "Linger left as it was" ;;
    *) usage; exit 1 ;;
  esac
}

case ${1:-help} in
  help|-h|--help) usage ;;
  setup) setup ;;
  on) shift; exec "$0" "$REMOTE_DEFAULT" "$@" ;;
  session) shift; session "$@" ;;
  ssh) shift; ssh_cmd "$@" ;;
  listen) shift; listen_cmd "$@" ;;
  protocol) shift; protocol_cmd "$@" ;;
  rdp) shift; rdp_cmd "$@" ;;
  port) shift; port_cmd "$@" ;;
  screen)
    local_desktop; busy && exit 0
    v=$(create_virtual "${2:-$REMOTE_SIZE}"); echo "$v" > "$STATE/virtual"
    start_vnc screen "$v" ;;
  mirror)
    local_desktop; busy && exit 0
    start_vnc mirror "$(~/.local/bin/brasa-monitors list | jq -r '[.[] | select(.focused)][0].name // .[0].name')" ;;
  take) shift; local_desktop; take "$@" ;;
  off)
    was=$(cat "$STATE/mode" 2>/dev/null)
    running && local_desktop
    if running; then systemctl --user stop "$UNIT"; fi   # take restores itself (ExecStopPost)
    [ "$(cat "$STATE/mode" 2>/dev/null)" = take ] || { remove_virtual; rm -f "$STATE/mode" "$STATE/output"; }
    firewall_sync
    if [ -n "$was" ]; then [ "$was" = take ] || say "$(mode_name "$was") OFF" "Port $REMOTE_LOCAL_PORT closed
$(also_on local)"
    else echo "No screen / mirror / take was on"; fi
    session_running && echo "(the remote session keeps running on $(where); 'brasa-remote session stop' ends it)"
    true ;;
  status)
    if running; then echo "local desktop: $(cat "$STATE/mode") on $(cat "$STATE/output") at $(where_local)"
      wayvncctl -S "$STATE/wayvnc.sock" client-list 2>/dev/null
    fi
    if session_running; then
      echo "remote session: $REMOTE_WM over $(protocol_name "$(serves_rdp && echo rdp)"), running at $(where)$(session_at_boot && echo ', starts at boot')"
      session_settings | sed 's/^/  /'
      if serves_rdp; then echo "  RDP connections: $(rdp_viewers "$(port_setting rdp)")"
      else wayvncctl -S "$STATE/session.sock" client-list 2>/dev/null; fi
    fi
    running || session_running || echo "off (all modes)"
    ssh_cmd status
    session_at_boot || echo "remote session ($REMOTE_WM) does not start at boot ('brasa-remote session boot')" ;;
  state) state_json ;;
  # ---- internal
  _session-vnc)   # inside the remote session: size the virtual output and serve it
    # (settings are read from remote.conf here, so changing them only needs a session restart)
    if hypr; then
      echo "$HYPRLAND_INSTANCE_SIGNATURE" > "$STATE/session-hypr"
      hypr_session_size "$REMOTE_SIZE"
      hyprctl -q output create headless "$SESSION_OUTPUT"
      [ "$REMOTE_RESIZE" = no ] || hypr_follow_viewer &
      serve_session "$SESSION_OUTPUT"
      exit
    fi
    sleep 1
    out=$(swaymsg -t get_outputs -r | jq -r '.[0].name')
    wlr-randr --output "$out" --custom-mode "${REMOTE_SIZE}@60Hz" >/dev/null 2>&1
    wlr-randr --output "$out" --scale "$(scale_for "$REMOTE_SIZE")" >/dev/null 2>&1
    # When the viewer resizes the session (wayvnc does it for the size it asks), follow with the scale
    if [ "$REMOTE_SCALE" = auto ] && [ "$REMOTE_RESIZE" != no ]; then
      ( last=""
        swaymsg -m -t subscribe '["output"]' 2>/dev/null | while read -r _; do
          size=$(swaymsg -t get_outputs -r | jq -r --arg o "$out" '.[] | select(.name == $o) | "\(.current_mode.width)x\(.current_mode.height)"')
          [ -n "$size" ] && [ "$size" != "$last" ] || continue
          last=$size; swaymsg -q output "$out" scale "$(scale_for "$size")"
        done ) &
    fi
    serve_session "$out" ;;
  _vkms) vkms_install ;;   # used by install.sh
  _firewall) firewall_install ;;   # used by install.sh
  _take-restore) take_restore ;;
  _take-watch)    # nobody connected to "take" in time: stop it (which restores everything)
    clients=$(wayvncctl -S "$STATE/wayvnc.sock" client-list 2>/dev/null | grep -c '^[[:space:]]*[0-9]')
    [ "${clients:-0}" -gt 0 ] || systemctl --user stop "$UNIT" ;;
  *) usage; exit 1 ;;
esac
