#!/usr/bin/env python3
"""brasa-tmpclean: remove what is left over in /tmp.

Looks at each top-level entry of /tmp (a file, or a folder as a whole) and removes it when nothing uses
it any more:
  - no process has a file in it open, as its working directory, or mapped (a library, a database),
  - no process names it on its command line (chrome --user-data-dir=/tmp/x, a server's socket path),
  - no socket in it is still listening,
  - nothing in it changed in the last --age minutes (so a build or a download in progress is left alone).
System entries (.X11-unix and the other X/ICE folders, systemd-private-*, tmux and Claude Code folders)
and mount points are never touched.

Without sudo it removes only your own entries, and it can only see your own processes. With sudo it sees
every process and also removes root's entries (and, with --all-users, everyone's).

Usage: brasa-tmpclean [--yes] [--age MINUTES] [--all-users] [--dir /tmp]
       sudo brasa-tmpclean --yes          also root's leftovers
       brasa-tmpclean --ask               for brasa-clean: prints "bytes<TAB>name" per entry and an empty
                                          line, then removes them if "yes" comes on stdin
Without --yes it only lists what it would remove.
"""
import argparse, os, pwd, re, shutil, stat, sys, time

KEEP = re.compile(r"^(\.X11-unix|\.ICE-unix|\.XIM-unix|\.font-unix|\.Test-unix|systemd-private-.*"
                  r"|tmux-\d+|claude-\d+|snap-private-tmp|lost\+found)$")
# Files an app only names (Qt's shared memory and single-instance keys): nobody keeps them open, so they
# count as in use while they are from this boot
SESSION = re.compile(r"^(qipc_.*|qtsingleapp-.*)$")
XLOCK = re.compile(r"^\.X\d+-lock$")   # an X server's lock: in use while the pid written in it lives


def booted():
    for line in open("/proc/stat"):
        if line.startswith("btime "):
            return int(line.split()[1])
    return 0


def xlock_alive(path):
    try:
        return os.path.exists(f"/proc/{int(open(path).read().strip())}")
    except (OSError, ValueError):
        return True


def human(n):
    for unit in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}T"


def top(path, base):
    """The top-level entry of base that path is in (None when it is not under base)."""
    if not path.startswith(base + "/"):
        return None
    return path[len(base) + 1:].split("/", 1)[0] or None


def in_use(base):
    """Names of the top-level entries some process uses, and how many processes could not be looked at."""
    used, hidden = {}, 0
    for pid in filter(str.isdigit, os.listdir("/proc")):
        proc = f"/proc/{pid}"
        try:
            name = open(f"{proc}/comm").read().strip()
        except OSError:
            continue
        def mark(path):
            t = top(path.removesuffix(" (deleted)"), base)
            if t:
                used.setdefault(t, f"{name} ({pid})")
        try:
            for link in ("cwd", "root", "exe"):
                try:
                    mark(os.readlink(f"{proc}/{link}"))
                except FileNotFoundError:
                    pass
            for fd in os.listdir(f"{proc}/fd"):
                try:
                    mark(os.readlink(f"{proc}/fd/{fd}"))
                except OSError:
                    pass
            for line in open(f"{proc}/maps"):
                parts = line.split(None, 5)
                if len(parts) == 6:
                    mark(parts[5].strip())
        except PermissionError:
            hidden += 1
        try:
            for arg in open(f"{proc}/cmdline", "rb").read().split(b"\0"):
                for m in re.finditer(re.escape(base) + r"/[^\s:;,'\"=]+", arg.decode(errors="replace")):
                    mark(m.group(0))
        except OSError:
            pass
    # Listening unix sockets (a socket file whose server is gone is a leftover)
    try:
        for line in open("/proc/net/unix").readlines()[1:]:
            parts = line.split()
            if len(parts) >= 8 and parts[3] == "00010000":   # flags: __SO_ACCEPTCON, a listening socket
                t = top(parts[7], base)
                if t:
                    used.setdefault(t, "listening socket")
    except OSError:
        pass
    return used, hidden


def mounts(base):
    out = set()
    for line in open("/proc/self/mountinfo"):
        t = top(line.split()[4].replace("\\040", " "), base)
        if t:
            out.add(t)
    return out


def scan(path, since):
    """(size, changed recently) of an entry, without following links; stops counting age early."""
    size, recent = 0, False
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return 0, False
    recent = max(st.st_mtime, st.st_ctime) > since
    if not stat.S_ISDIR(st.st_mode):
        return st.st_size, recent
    for root, dirs, files in os.walk(path, onerror=lambda e: None):
        for n in dirs + files:
            try:
                s = os.lstat(os.path.join(root, n))
            except OSError:
                continue
            size += s.st_size if not stat.S_ISDIR(s.st_mode) else 0
            recent = recent or max(s.st_mtime, s.st_ctime) > since
    return size, recent


def remove(path):
    st = os.lstat(path)
    if stat.S_ISDIR(st.st_mode):
        shutil.rmtree(path)
    else:
        os.unlink(path)


def leftovers(base, owners, age, verbose=False):
    """[(name, size)] of the entries nothing uses, how many were kept, and how many processes could not be
    looked at."""
    used, hidden = in_use(base)
    mounted = mounts(base)
    since = time.time() - age * 60
    boot = booted()
    known_uids = {p.pw_uid: p.pw_name for p in pwd.getpwall()}
    found, kept = [], 0
    for name in sorted(os.listdir(base)):
        path = os.path.join(base, name)
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            continue
        why = None
        if KEEP.match(name):
            why = "system"
        elif owners is not None and st.st_uid not in owners:
            why = f"owner {known_uids.get(st.st_uid, st.st_uid)}"
        elif name in mounted:
            why = "mount point"
        elif name in used:
            why = f"in use: {used[name]}"
        elif SESSION.match(name) and st.st_mtime > boot:
            why = "app key from this boot"
        elif XLOCK.match(name) and xlock_alive(path):
            why = "X server running"
        size, recent = (0, False) if why else scan(path, since)
        if not why and recent:
            why = f"changed in the last {age:g} min"
        if why:
            kept += 1
            if verbose:
                print(f"  keep  {name}  ({why})")
            continue
        found.append((name, size))
    return found, kept, hidden


def remove_all(base, names):
    for name in names:
        try:
            remove(os.path.join(base, name))
            yield name, None
        except OSError as e:
            yield name, e


def ask(base, owners, age):
    found, _, _ = leftovers(base, owners, age)
    for name, size in found:
        print(f"{size}\t{name}")
    print(flush=True)
    if sys.stdin.readline().strip() != "yes":
        return
    still_unused = {name for name, _ in leftovers(base, owners, age)[0]}
    for name, error in remove_all(base, [n for n, _ in found if n in still_unused]):
        print(f"failed\t{name}\t{error}" if error else f"removed\t{name}", flush=True)


def main():
    ap = argparse.ArgumentParser(description="Remove the leftovers in /tmp that nothing uses.")
    ap.add_argument("--yes", "-y", action="store_true", help="remove them (default: only list)")
    ap.add_argument("--ask", action="store_true", help="list them for a program, remove them if it answers yes")
    ap.add_argument("--age", type=float, default=60, help="minutes without changes before an entry counts (60)")
    ap.add_argument("--all-users", action="store_true", help="with sudo: every user's entries, not only yours and root's")
    ap.add_argument("--dir", default="/tmp")
    ap.add_argument("--verbose", "-v", action="store_true", help="also list what is kept and why")
    a = ap.parse_args()
    base = os.path.realpath(a.dir)
    root = os.geteuid() == 0
    me = int(os.environ.get("SUDO_UID", os.environ.get("PKEXEC_UID", os.getuid())))
    owners = None if (root and a.all_users) else ({me, 0} if root else {me})
    if a.ask:
        ask(base, owners, a.age)
        return

    gone, kept, hidden = leftovers(base, owners, a.age, a.verbose)
    total = sum(size for _, size in gone)
    for name, size in gone:
        print(f"{'remove' if a.yes else 'would remove'}  {human(size):>7}  {name}")
    if a.yes:
        for name, error in remove_all(base, [n for n, _ in gone]):
            if error:
                print(f"    failed: {error}", file=sys.stderr)
    print(f"\n{len(gone)} entries, {human(total)} {'removed' if a.yes else 'to remove'}; {kept} kept"
          + ("" if a.yes or not gone else "  ->  run again with --yes to remove them"))
    if hidden and not root:
        print(f"({hidden} processes of other users could not be looked at: only your own entries are touched;"
              " sudo brasa-tmpclean also checks theirs and cleans root's)")


if __name__ == "__main__":
    main()
