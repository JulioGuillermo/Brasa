#!/usr/bin/env bash
# Battery charge limit: stop charging at a given level (80 % keeps a battery healthier for longer).
# Usage: brasa-battery          show the current limit
#        brasa-battery N        charge up to N % (20-100, e.g. 60, 80, 100); kept across reboots
#        brasa-battery menu     choose with a menu (fuzzel), e.g. from the bar or the control panel
# Needs a laptop whose kernel driver offers charge_control_end_threshold (ASUS, Lenovo, Dell, Huawei,
# Samsung, Framework, System76...). The first change asks for sudo once: it installs a udev rule that
# applies the saved limit at every boot and lets your user change it without sudo afterwards.
set -u
SAVED=/etc/brasa/battery-limit
RULE=/etc/udev/rules.d/90-brasa-battery.rules
node() { ls /sys/class/power_supply/BAT*/charge_control_end_threshold 2>/dev/null | head -1; }
say() { ~/.local/bin/brasa-osd battery-good-charging-symbolic "$1" 2>/dev/null; echo "$1"; }

root_setup() {  # as root: USER — the rule, the saved value file and permission for the user's group
  local user=$1 group; group=$(id -gn "$user")
  mkdir -p /etc/brasa
  [ -f "$SAVED" ] || cat "$(node)" > "$SAVED"
  chgrp "$group" "$SAVED"; chmod 664 "$SAVED"
  cat > "$RULE" <<RULES
# Written by brasa-battery: apply the saved charge limit at boot and let group $group change it.
SUBSYSTEM=="power_supply", KERNEL=="BAT*", ATTR{charge_control_end_threshold}=="*", \\
  RUN+="/bin/sh -c 'f=/sys%p/charge_control_end_threshold; chgrp $group \$\$f; chmod g+w \$\$f; [ -s $SAVED ] && cat $SAVED > \$\$f'"
RULES
  udevadm control --reload
  udevadm trigger --subsystem-match=power_supply --action=change
}

f=$(node)
case ${1:-} in
  _root-setup) root_setup "$2"; exit ;;
  -h|--help|help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
[ -n "$f" ] || { echo "This machine offers no battery charge limit."; exit 1; }
case ${1:-} in
  "") echo "Charge limit: $(cat "$f") %" ;;
  menu)
    cur=$(cat "$f")
    pick=$(printf '%s\n' "60 %" "80 %" "90 %" "100 %" | sed "s/^$cur %\$/$cur %  (current)/" |
           fuzzel --dmenu --prompt "Charge up to  " --lines 4 --width 24 2>/dev/null) || exit 0
    exec "$0" "${pick%% *}" ;;
  *)
    n=$1
    [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 20 ] && [ "$n" -le 100 ] || { echo "A limit between 20 and 100" >&2; exit 1; }
    if [ ! -w "$f" ] || [ ! -w "$SAVED" ]; then
      echo "First time: setting up the charge limit (asks for sudo once)"
      sudo "$(readlink -f "$0")" _root-setup "$USER" || exit 1
      sleep 0.5
    fi
    if echo "$n" > "$f" 2>/dev/null; then echo "$n" > "$SAVED"
    else echo "$n" | sudo tee "$f" >/dev/null && echo "$n" | sudo tee "$SAVED" >/dev/null || exit 1; fi
    say "Battery charges up to $(cat "$f") %" ;;
esac
