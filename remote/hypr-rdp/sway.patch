+//! sway IPC. Each message is "i3-ipc", the payload length and the message type (both native-endian
+//! u32), then the payload; replies have the same shape.
+
+use std::io::{Read, Write};
+use std::os::unix::net::UnixStream;
+use std::time::{Duration, Instant};
+
+use anyhow::{bail, Context, Result};
+use serde_json::{json, Value};
+
+const MAGIC: &[u8] = b"i3-ipc";
+const HEADER_LEN: usize = 14;
+const RUN_COMMAND: u32 = 0;
+const GET_OUTPUTS: u32 = 3;
+const NEW_OUTPUT_TIMEOUT: Duration = Duration::from_secs(5);
+const NEW_OUTPUT_POLL: Duration = Duration::from_millis(50);
+
+pub fn running() -> bool {
+    std::env::var_os("SWAYSOCK").is_some_and(|path| !path.is_empty())
+}
+
+fn request(kind: u32, payload: &str) -> Result<Value> {
+    let path = std::env::var("SWAYSOCK").context("SWAYSOCK is not set")?;
+    let mut sock = UnixStream::connect(&path)
+        .with_context(|| format!("failed to connect to sway socket: {}", path))?;
+    sock.set_read_timeout(Some(Duration::from_secs(3)))?;
+
+    let mut message = MAGIC.to_vec();
+    message.extend((payload.len() as u32).to_ne_bytes());
+    message.extend(kind.to_ne_bytes());
+    message.extend(payload.as_bytes());
+    sock.write_all(&message)?;
+
+    let mut header = [0u8; HEADER_LEN];
+    sock.read_exact(&mut header)?;
+    if &header[..MAGIC.len()] != MAGIC {
+        bail!("sway IPC reply does not start with i3-ipc");
+    }
+    let length = u32::from_ne_bytes(header[6..10].try_into()?) as usize;
+    let mut reply = vec![0u8; length];
+    sock.read_exact(&mut reply)?;
+    serde_json::from_slice(&reply).context("failed to parse sway IPC reply")
+}
+
+/// Runs sway commands and fails with sway's own message if any of them failed.
+fn run(command: &str) -> Result<()> {
+    let replies = request(RUN_COMMAND, command)?;
+    for reply in replies
+        .as_array()
+        .context("expected an array of command results")?
+    {
+        if reply["success"] != true {
+            let error = reply["error"].as_str().unwrap_or("unknown error");
+            bail!("sway command '{}' failed: {}", command, error);
+        }
+    }
+    Ok(())
+}
+
+fn active_outputs() -> Result<Vec<Value>> {
+    let outputs = request(GET_OUTPUTS, "")?;
+    let outputs = outputs.as_array().context("expected an outputs array")?;
+    Ok(outputs
+        .iter()
+        .filter(|output| output["active"] == true)
+        .cloned()
+        .collect())
+}
+
+/// The active outputs in the shape Hyprland's `j/monitors` has: name, position in the layout, and
+/// size in pixels.
+pub fn monitors() -> Result<Value> {
+    let monitors: Vec<Value> = active_outputs()?.iter().map(monitor_from_output).collect();
+    Ok(Value::Array(monitors))
+}
+
+fn monitor_from_output(output: &Value) -> Value {
+    json!({
+        "name": output["name"],
+        "x": output["rect"]["x"],
+        "y": output["rect"]["y"],
+        "width": output["current_mode"]["width"],
+        "height": output["current_mode"]["height"],
+    })
+}
+
+/// Returns the name sway gave the new output: the one that was not there before.
+pub fn create_headless_output() -> Result<String> {
+    let before = output_names()?;
+    run("create_output")?;
+    let start = Instant::now();
+    loop {
+        if let Some(name) = output_names()?
+            .into_iter()
+            .find(|name| !before.contains(name))
+        {
+            return Ok(name);
+        }
+        if start.elapsed() >= NEW_OUTPUT_TIMEOUT {
+            bail!(
+                "sway created no output within {}ms",
+                NEW_OUTPUT_TIMEOUT.as_millis()
+            );
+        }
+        std::thread::sleep(NEW_OUTPUT_POLL);
+    }
+}
+
+fn output_names() -> Result<Vec<String>> {
+    let outputs = request(GET_OUTPUTS, "")?;
+    let outputs = outputs.as_array().context("expected an outputs array")?;
+    Ok(outputs
+        .iter()
+        .filter_map(|output| output["name"].as_str().map(str::to_owned))
+        .collect())
+}
+
+/// Sets the size and scale, and places the output left of every other one.
+pub fn set_output_mode(name: &str, width: u32, height: u32, scale: f64) -> Result<()> {
+    let logical_width = (f64::from(width) / scale).round() as i64;
+    let x = left_edge_of_others(name)? - logical_width;
+    run(&format!(
+        "output {name} mode --custom {width}x{height}@60Hz scale {scale} position {x} 0"
+    ))
+}
+
+fn left_edge_of_others(name: &str) -> Result<i64> {
+    let left_edge = active_outputs()?
+        .iter()
+        .filter(|output| output["name"].as_str() != Some(name))
+        .filter_map(|output| output["rect"]["x"].as_i64())
+        .min();
+    Ok(left_edge.unwrap_or(0))
+}
+
+pub fn remove_output(name: &str) -> Result<()> {
+    run(&format!("output {name} unplug"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn monitor_takes_the_layout_position_and_the_pixel_size() {
+        let output = json!({
+            "name": "HEADLESS-2",
+            "active": true,
+            "rect": { "x": 1280, "y": 0, "width": 960, "height": 540 },
+            "current_mode": { "width": 1920, "height": 1080, "refresh": 60000 },
+        });
+
+        assert_eq!(
+            monitor_from_output(&output),
+            json!({ "name": "HEADLESS-2", "x": 1280, "y": 0, "width": 1920, "height": 1080 })
+        );
+    }
+}
