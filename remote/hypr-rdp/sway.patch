diff --git a/src/compositor.rs b/src/compositor.rs
new file mode 100644
index 0000000..0f26122
--- /dev/null
+++ b/src/compositor.rs
@@ -0,0 +1,111 @@
+//! The window manager hypr-rdp drives, Hyprland or sway, found once at start. Everything that asks it
+//! for outputs or keyboard settings goes through here; the screen capture and the input already use
+//! Wayland protocols both of them have.
+
+use std::sync::OnceLock;
+use std::time::Duration;
+
+use anyhow::{Context, Result};
+
+use crate::{hyprland, sway};
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Compositor {
+    Hyprland,
+    Sway,
+}
+
+static COMPOSITOR: OnceLock<Compositor> = OnceLock::new();
+
+/// Sway when its socket is set and no Hyprland signature is; otherwise Hyprland, which is also found
+/// from the instance that owns WAYLAND_DISPLAY.
+fn detect() -> Compositor {
+    let hyprland_signature =
+        std::env::var_os("HYPRLAND_INSTANCE_SIGNATURE").filter(|s| !s.is_empty());
+    if hyprland_signature.is_none() && sway::running() {
+        Compositor::Sway
+    } else {
+        Compositor::Hyprland
+    }
+}
+
+fn current() -> Compositor {
+    *COMPOSITOR.get_or_init(detect)
+}
+
+/// Returns the Hyprland instance signature, which session hooks get; sway has none.
+pub fn initialize() -> Result<Option<String>> {
+    match current() {
+        Compositor::Hyprland => hyprland::initialize()
+            .map(Some)
+            .context("failed to select the Hyprland instance"),
+        Compositor::Sway => {
+            sway::monitors().context("failed to reach sway through SWAYSOCK")?;
+            Ok(None)
+        }
+    }
+}
+
+pub fn is_sway() -> bool {
+    current() == Compositor::Sway
+}
+
+/// The outputs as Hyprland's `j/monitors` has them: name, x, y, and width and height in pixels.
+pub fn monitors() -> Result<serde_json::Value> {
+    match current() {
+        Compositor::Hyprland => hyprland::monitors(),
+        Compositor::Sway => sway::monitors(),
+    }
+}
+
+/// Creates a headless output and returns its name. Hyprland names it after `prefix`; sway names it
+/// itself.
+pub fn create_headless_output(prefix: &str) -> Result<String> {
+    match current() {
+        Compositor::Hyprland => create_hyprland_headless_output(prefix),
+        Compositor::Sway => sway::create_headless_output(),
+    }
+}
+
+/// Subscribes before creating it, to catch its monitoradded event.
+fn create_hyprland_headless_output(prefix: &str) -> Result<String> {
+    let mut events = hyprland::EventStream::connect()?;
+    events.ensure_registered()?;
+    hyprland::output_create_headless(prefix)?;
+    loop {
+        let name = events
+            .wait_for("monitoradded", Duration::from_secs(5))
+            .context("failed to detect new headless output")?;
+        if name.starts_with(prefix) {
+            return Ok(name);
+        }
+        tracing::trace!(%name, "Ignoring unrelated monitoradded event");
+    }
+}
+
+/// True for an output an earlier run created and left behind. Always false on sway: its HEADLESS-N
+/// names do not say who created them.
+pub fn is_own_headless_output(name: &str, prefix: &str) -> bool {
+    match current() {
+        Compositor::Hyprland => name.starts_with(prefix),
+        Compositor::Sway => false,
+    }
+}
+
+pub fn set_output_mode(name: &str, width: u32, height: u32, scale: f64) -> Result<()> {
+    match current() {
+        Compositor::Hyprland => {
+            let rule =
+                hyprland::headless_monitor_rule(name, &format!("{width}x{height}@60"), scale);
+            hyprland::keyword_monitor(&rule)
+        }
+        Compositor::Sway => sway::set_output_mode(name, width, height, scale),
+    }
+}
+
+pub fn remove_output(name: &str) -> Result<()> {
+    match current() {
+        Compositor::Hyprland => hyprland::output_remove(name),
+        Compositor::Sway => sway::remove_output(name),
+    }
+}
