# Brasa (brasa-remote session, Hyprland): the virtual screen (vkms) is a seat of its own, seat1, so the
# remote Hyprland and the local session are both active at once and the local one does not see it.
SUBSYSTEM=="drm", KERNEL=="card*", DEVPATH=="/devices/faux/vkms/*", ENV{ID_SEAT}="seat1", TAG+="master-of-seat"
SUBSYSTEM=="graphics", DEVPATH=="/devices/faux/vkms/*", ENV{ID_SEAT}="seat1"
