// Brasa: each user starts and stops their own remote Hyprland session (brasa-remote session) without
// a password, also over SSH.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "brasa-remote-hyprland@" + subject.user + ".service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0) {
        return polkit.Result.YES;
    }
});
