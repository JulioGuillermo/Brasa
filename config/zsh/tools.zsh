# ~/.config/zsh/tools.zsh: tool set-ups (version managers, SDKs, completions). Loaded by ~/.zshrc after
# the aliases and before the prompt. Brasa created it empty and never overwrites it.
# Installers that append to ~/.zshrc (nvm, rbenv, gcloud...) can be moved here. Examples:
#
# export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
# command -v rbenv >/dev/null && eval "$(rbenv init - zsh)"
# [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
# Keep secrets (API keys, tokens) here or in a file sourced from here, never in the brasa folder.
