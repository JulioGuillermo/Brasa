/* Brasa · Redline for rofi: the full-screen app grid (Super+d, bin/brasa-drawer) over night blue */

configuration {
  modi: "drun";
  show-icons: true;
  display-drun: "";
  drun-display-format: "{name}";
  drun-match-fields: "name,generic,exec,categories,keywords";
  disable-history: false;
  sort: true;
  sorting-method: "fzf";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";   /* one click opens the app */
  kb-cancel: "Escape,Super+d";
}

* {
  night:   rgba(0, 4, 15, 92%);
  card:    #0c1838;
  line:    #2c3a5e;
  red:     #ff0000;
  white:   #ffffff;
  sub:     #c3cbe0;
  dim:     #5a6a90;
  font: "Hack Nerd Font Propo 11";
  background-color: transparent;
  text-color: @sub;
}

window {
  fullscreen: true;
  width: 100%;
  height: 100%;
  background-color: @night;
  border: 0;
}

mainbox {
  border: 0;
  padding: 6% 9% 4% 9%;
  spacing: 4%;
  children: [ inputbar, listview ];
}

/* Search box, centred */
inputbar {
  margin: 0 33%;
  padding: 10px 16px;
  spacing: 10px;
  background-color: @card;
  border: 1px;
  border-color: @red;
  border-radius: 12px;
  children: [ prompt, entry ];
}
prompt { text-color: @red; }
entry {
  placeholder: "Search apps";
  placeholder-color: @dim;
  text-color: @white;
  cursor-color: @red;
  font: "Hack Nerd Font Propo 13";
}

listview {
  columns: 7;
  lines: 4;
  fixed-columns: true;
  fixed-height: true;
  cycle: false;
  scrollbar: false;
  spacing: 18px;
  flow: horizontal;
  border: 0;
}

element {
  orientation: vertical;
  padding: 16px 8px 12px 8px;
  spacing: 10px;
  border: 0 0 2px 0;
  border-color: transparent;
  border-radius: 14px;
  cursor: pointer;
}
/* rofi's built-in theme paints every row (light); Brasa's cells are clear until selected */
element normal.normal, element alternate.normal, element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent {
  background-color: transparent;
  text-color: @sub;
}
element selected.normal, element selected.active, element selected.urgent {
  background-color: @card;
  border-color: @red;
}
element-icon {
  size: 64px;
  background-color: transparent;
  horizontal-align: 0.5;
  cursor: inherit;
}
element-text {
  background-color: transparent;
  horizontal-align: 0.5;
  vertical-align: 0.5;
  text-color: inherit;
  cursor: inherit;
}
element selected.normal element-text { text-color: @white; }

message { padding: 8px; border-radius: 12px; background-color: @card; }
textbox { text-color: @sub; }
