#!/usr/bin/env bash
# Sensors for the Brasa bar (no root needed). Usage: sens thermal|volt -> waybar JSON.
# Generic: CPU temperature from coretemp (Intel), k10temp/zenpower (AMD), cpu_thermal (ARM) or acpitz;
# every fan any hwmon driver exposes; the first battery. Missing hardware prints nothing (block hidden).
# "text" is the whole block, "alt" the folded one (the bar's right click switches between them).
ic() { printf "<span color='#ff0000'>%s</span>" "$1"; }
hw() { for h in /sys/class/hwmon/hwmon*; do [ "$(cat $h/name)" = "$1" ] && { echo $h; return; }; done; }
out() { printf '{"text":"%s","alt":"%s","tooltip":"%s","class":"%s"}\n' "$1" "$2" "$3" "$4"; }
lvl() { # value warm_threshold hot_threshold critical_threshold
  if [ "$1" -ge "$4" ]; then echo crit; elif [ "$1" -ge "$3" ]; then echo hot
  elif [ "$1" -ge "$2" ]; then echo warm; else echo cool; fi; }
rank() { case $1 in crit) echo 3 ;; hot) echo 2 ;; warm) echo 1 ;; *) echo 0 ;; esac; }
hotter() { # the hotter of two levels
  if [ "$(rank "$1")" -ge "$(rank "$2")" ]; then echo "$1"; else echo "$2"; fi; }

# Sets temp_text, temp_tip and temp_class; empty when there is no CPU sensor
read_temp() {
  temp_text="" temp_tip="" temp_class=cool
  local c n f l t h
  for n in coretemp k10temp zenpower cpu_thermal acpitz; do c=$(hw $n); [ -n "$c" ] && break; done
  [ -z "$c" ] && return
  # Package / Tctl / first sensor
  f=$c/temp1_input
  for l in $c/temp*_label; do case $(cat "$l" 2>/dev/null) in "Package id 0"|Tctl|Tdie) f=${l%_label}_input; break ;; esac; done
  t=$(( $(cat $f) / 1000 ))
  temp_tip="CPU ${t}°C"
  for n in nvme amdgpu iwlwifi_1; do h=$(hw $n); [ -n "$h" ] && [ -r $h/temp1_input ] && temp_tip+="\\n$n $(( $(cat $h/temp1_input) / 1000 ))°C"; done
  temp_text="$(ic '') ${t}°"
  temp_class=$(lvl $t 65 80 90)
}

# Sets fan_text, fan_tip and fan_class; empty when no hwmon driver exposes a fan
read_fans() {
  fan_text="" fan_tip="" fan_class=cool
  local vals=() m=0 f v name lab
  # Every fan of every hwmon driver (asus, thinkpad, dell_smm, nct6775, it87, amdgpu...), first two shown.
  # Vendor drivers first; the generic acpi_fan usually reads 0
  for f in $(ls /sys/class/hwmon/hwmon*/fan*_input 2>/dev/null | while read -r x; do
               [ "$(cat "$(dirname "$x")/name")" = acpi_fan ] && echo "1 $x" || echo "0 $x"; done | sort | cut -d" " -f2); do
    [ -r "$f" ] || continue
    v=$(cat "$f" 2>/dev/null) || continue
    name=$(cat "$(dirname "$f")/name"); lab=$(cat "${f%_input}_label" 2>/dev/null || basename "${f%_input}")
    vals+=("$v"); fan_tip+="$name $lab: $v rpm\\n"; [ "$v" -gt "$m" ] && m=$v
  done
  [ ${#vals[@]} -eq 0 ] && return
  fan_text="$(ic '󰈐') ${vals[*]:0:2}<small>rpm</small>"
  fan_tip=${fan_tip%\\n}
  fan_class=$(lvl $m 3000 4500 5500)
}

case $1 in
thermal)
  # Temperature and fans in one block; folded, the temperature alone (or the fans, without a sensor)
  read_temp; read_fans
  [ -z "$temp_text$fan_text" ] && { out "" "" "" ""; exit 0; }
  text="$temp_text${temp_text:+${fan_text:+ }}$fan_text"
  tip="$temp_tip${temp_tip:+${fan_tip:+\\n}}$fan_tip"
  out "$text" "${temp_text:-$fan_text}" "$tip" "$(hotter "$temp_class" "$fan_class")" ;;
volt)
  b=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)
  [ -z "$b" ] || [ ! -r "$b/voltage_now" ] && { out "" "" "" ""; exit 0; }
  v=$(cat $b/voltage_now)
  printf -v vs "%d.%d" $(( v / 1000000 )) $(( v / 100000 % 10 ))
  out "${vs}<small>V</small>" "$(ic '󰉁')" "Battery: $(cat $b/status), ${vs} V\\nCycles: $(cat $b/cycle_count 2>/dev/null || echo ?)" "cool" ;;
esac
