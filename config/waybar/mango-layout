#!/usr/bin/env bash
# mango: the window layout of the focused tag (Super+w changes it), following mango's monitor updates.
declare -A ICON=(
  [DW]=$'\U000F056E' [T]=$'\U000F0574' [CT]=$'\U000F0574' [S]=$'\U000F0BCD' [VS]=$'\U000F0BCE'
  [M]=$'\U000F0293' [G]=$'\U000F0570' [RT]=$'\U000F06FE' [VT]=$'\U000F06FC' [K]=$'\U000F0638'
  [VK]=$'\U000F06C7' [VG]=$'\U000F0573' [F]=$'\U000F056D' [VF]=$'\U000F0729')
declare -A NAME=(
  [DW]="Split · new ones halve the focused"
  [T]="Main · big one on the left"
  [RT]="Main · big one on the right"
  [CT]="Main · big one in the middle"
  [VT]="Main · big one on top"
  [K]="Cards · big one left, rest piled"
  [VK]="Cards · big one on top, rest piled"
  [G]="Grid · in columns"
  [VG]="Grid · in rows"
  [F]="Even · same size, in columns"
  [VF]="Even · same size, in rows"
  [S]="Scroll · side by side →"
  [VS]="Scroll · one above the other ↓"
  [M]="Full · one window at a time")

last=""
mmsg watch all-monitors | while read -r update; do
  symbol=$(jq -r '[.monitors[] | select(.active)][0].layout_symbol // .monitors[0].layout_symbol' <<< "$update")
  [ "$symbol" = "$last" ] && continue
  last=$symbol
  jq -cn --arg icon "${ICON[$symbol]:-${ICON[DW]}}" --arg name "${NAME[$symbol]:-$symbol}" \
    '{text: $icon, tooltip: "Layout of this tag: \($name)\nSuper+w or a click: the next one"}'
done
